@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix shape: <https://ekgf.org/ontology/shape#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix annotation: <https://ekgf.org/ontology/annotation#> .
@base <https://ekgf.org/ontology/shape#> .

<https://ekgf.org/ontology/shape#>
    rdf:type owl:Ontology ;
    rdfs:label "The EKG Shape Ontology"@en ;
    rdfs:comment "Metadata vocabulary for grouping SHACL node shapes into shapesets and for saying what a shape is for."@en ;
    annotation:markdownDescription "Defines `shape:ShapeSet` and membership properties for grouping SHACL node shapes into governed shapesets, and `shape:ShapePurpose` with `shape:shapePurpose` for saying what a shape is for."@en .

shape:ShapeSet rdf:type owl:Class ;
    rdfs:label "ShapeSet"@en ;
    rdfs:comment "A managed collection of related SHACL node shapes."@en .

shape:ShapePurpose rdf:type owl:Class ;
    rdfs:label "Shape purpose"@en ;
    rdfs:comment "What a shape is for. The purposes are controlled values, each an instance of this class."@en .

shape:hasNodeShape rdf:type owl:AnnotationProperty ;
    rdfs:domain shape:ShapeSet ;
    rdfs:range sh:NodeShape ;
    rdfs:label "Has node shape"@en ;
    rdfs:comment "Relates a shapeset to a SHACL node shape that belongs to it. It is an annotation property because a node shape can also be a class, and a class is not an individual."@en .

shape:inShapeSet rdf:type owl:AnnotationProperty ;
    rdfs:domain sh:NodeShape ;
    rdfs:range shape:ShapeSet ;
    rdfs:label "In shapeset"@en ;
    rdfs:comment "Relates a SHACL node shape to the shapeset it belongs to. It is an annotation property because a node shape can also be a class, and a class is not an individual."@en .

shape:shapePurpose rdf:type owl:AnnotationProperty ;
    rdfs:range shape:ShapePurpose ;
    rdfs:label "Shape purpose"@en ;
    rdfs:comment "Relates a shape to what it is for. It is an annotation property because a node shape can also be a class, and a class is not an individual."@en .
