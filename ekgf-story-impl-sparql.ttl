###  https://ekgf.org/ontology/story-impl-sparql#StorySPARQLImplementation
sparql-story:StorySPARQLImplementation rdf:type owl:Class ;
  rdfs:subClassOf story:StoryImplementation ;
  rdfs:isDefinedBy <https://ekgf.org/ontology/story-impl-sparql#> .

:StorySPARQLTemplateImplementation a owl:Class ;
    rdfs:subClassOf :StorySPARQLImplementation , [
        a owl:Restriction ; owl:onProperty :hasTemplate ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] , [
        a owl:Restriction ; owl:onProperty :usesRenderer ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Story SPARQL Template Implementation"@en ;
    rdfs:comment "A story implementation that produces executable SPARQL by rendering exactly one template document with exactly one selected renderer. Its source is a document in a template language; the generated statement is SPARQL."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/story-impl-sparql#> .

:StatementTemplate a owl:Class ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty concept:templateLanguage ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] , [
        a owl:Restriction ; owl:onProperty concept:templateLanguage ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Statement Template"@en ;
    rdfs:comment "A document in one declared template language/profile, stored inline or in a file, that a renderer turns into a SPARQL query or update. It is template source even when its unexpanded text happens to parse as SPARQL."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/story-impl-sparql#> .

:TemplateRenderer a owl:Class ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty :supportsTemplateLanguage ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    rdfs:label "Template Renderer"@en ;
    rdfs:comment "A software component that renders statement-template documents using story input values and explicitly declares the template-language profiles it supports. The execution service is responsible for safe typed substitution and validation of generated SPARQL."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/story-impl-sparql#> .


###  https://ekgf.org/ontology/story-impl-sparql#StorySPARQLQueryImplementation
sparql-story:StorySPARQLQueryImplementation rdf:type owl:Class ;
  rdfs:subClassOf sparql-story:StorySPARQLImplementation ;
  rdfs:comment "Story SPARQL Implementation for query statements like `SELECT`, `CONSTRUCT`, `ASK` and `DESCRIBE`"@en ;
  rdfs:isDefinedBy <https://ekgf.org/ontology/story-impl-sparql#> .


###  https://ekgf.org/ontology/story-impl-sparql#StorySPARQLUpdateImplementation
sparql-story:StorySPARQLUpdateImplementation rdf:type owl:Class ;
  rdfs:subClassOf sparql-story:StorySPARQLImplementation ;
  rdfs:comment "Story SPARQL Implementation for update statements like `INSERT/DELETE/WHERE` etc"@en ;
  rdfs:isDefinedBy <https://ekgf.org/ontology/story-impl-sparql#> .


