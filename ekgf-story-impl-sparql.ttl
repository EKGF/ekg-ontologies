<https://ekgf.org/ontology/story-impl-sparql#> rdf:type owl:Ontology ;
  sh:declare [
      sh:prefix "ekg-story-impl-sparql" ;
      sh:namespace "https://ekgf.org/ontology/story-impl-sparql#"^^xsd:anyURI
  ] ;
    owl:imports
        concept:,
        story:,
        ekg-shape: ;
    rdfs:comment
        """The SPARQL Story Implementation Ontology defines story implementations using executable SPARQL queries or updates, or explicitly declared template documents and renderers that generate SPARQL.

       The Story ontology itself is: https://ekgf.org/ontology/story#"""@en ;
    rdfs:label "SPARQL Story Implementation Ontology"@en .

#################################################################
#    Object Properties
#################################################################

###  https://ekgf.org/ontology/story-impl-sparql#flavor
sparql-story:flavor rdf:type owl:ObjectProperty ;
    rdfs:domain sparql-story:StorySPARQLImplementation ;
    rdfs:range sparql-story:SPARQLFlavor ;
    rdfs:label
        "Supports SPARQL Flavor"@en-us,
        "Supports SPARQL Flavour"@en .

:hasTemplate a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :StorySPARQLTemplateImplementation ;
    rdfs:range :StatementTemplate ;
    rdfs:label "has template"@en ;
    rdfs:comment "Links a SPARQL-producing story implementation to its template document. The source language is declared on that document; its text is not executable SPARQL source."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/story-impl-sparql#> .

:usesRenderer a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :StorySPARQLTemplateImplementation ;
    rdfs:range :TemplateRenderer ;
    rdfs:label "uses renderer"@en ;
    rdfs:comment "Identifies the renderer selected for this template-based implementation. It must explicitly support the template document's declared language/profile."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/story-impl-sparql#> .

:supportsTemplateLanguage a owl:ObjectProperty ;
    rdfs:domain :TemplateRenderer ;
    rdfs:range concept:TemplateLanguage ;
    rdfs:label "supports template language"@en ;
    rdfs:comment "Records a documented template-language profile implemented by a renderer. Support is an explicit capability assertion, not proof of safe RDF serialization or approval to execute."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/story-impl-sparql#> .


#################################################################
#    Data properties
#################################################################

###  https://ekgf.org/ontology/story-impl-sparql#fileName
sparql-story:fileName rdf:type
        owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain sparql-story:StorySPARQLImplementation ;
    rdfs:comment
        """The name of the file name that contains the SPARQL implementation of the given Story.

       This name is assumed to be relative to the directory where the Turtle file containing the StoryImplementation lives."""@en ;
    rdfs:label "File name"@en .


###  https://ekgf.org/ontology/story-impl-sparql#sparql
sparql-story:sparql rdf:type
        owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain sparql-story:StorySPARQLImplementation ;
    rdfs:comment "Executable SPARQL query or update text. Template source belongs to a StatementTemplate linked through hasTemplate and must be rendered before the resulting SPARQL is parsed and executed."@en ;
    rdfs:label "SPARQL statement"@en .

:templateText a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :StatementTemplate ;
    rdfs:range xsd:string ;
    rdfs:label "template text"@en ;
    rdfs:comment "The unrendered template document's source text, interpreted in its declared template language. Parsing this text as SPARQL does not replace template rendering."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/story-impl-sparql#> .

:templateFileName a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :StatementTemplate ;
    rdfs:range xsd:string ;
    rdfs:label "template file name"@en ;
    rdfs:comment "The file containing a template document, relative to the document's source context. It identifies template source rather than a file of executable SPARQL."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/story-impl-sparql#> .


