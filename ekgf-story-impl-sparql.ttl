#################################################################
#    Template validation
#################################################################

:StatementTemplateShape a sh:NodeShape ;
    sh:targetClass :StatementTemplate ;
    sh:targetObjectsOf :hasTemplate ;
    sh:targetSubjectsOf :templateText , :templateFileName ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [
        sh:path concept:templateLanguage ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:nodeKind sh:IRI ; sh:class concept:TemplateLanguage
    ] ;
    sh:or (
        [ sh:property [ sh:path :templateText ; sh:minCount 1 ] ]
        [ sh:property [ sh:path :templateFileName ; sh:minCount 1 ] ]
    ) ;
    sh:property [
        sh:path :templateText ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:minLength 1
    ] ;
    sh:property [
        sh:path :templateFileName ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:minLength 1
    ] ;
    rdfs:label "Statement Template Shape"@en ;
    rdfs:comment "Requires one documented template-language profile and nonempty inline or file-based template source. Source content and its file location may both be supplied."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/story-impl-sparql#> .

:TemplateRendererShape a sh:NodeShape ;
    sh:targetClass :TemplateRenderer ;
    sh:targetObjectsOf :usesRenderer ;
    sh:targetSubjectsOf :supportsTemplateLanguage ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [
        sh:path :supportsTemplateLanguage ;
        sh:minCount 1 ; sh:nodeKind sh:IRI ; sh:class concept:TemplateLanguage
    ] ;
    rdfs:label "Template Renderer Shape"@en ;
    rdfs:comment "Requires a renderer to explicitly identify the template-language profiles it supports. Execution approval and safe substitution remain application responsibilities."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/story-impl-sparql#> .

:StorySPARQLTemplateImplementationShape a sh:NodeShape ;
    sh:targetClass :StorySPARQLTemplateImplementation ;
    sh:targetSubjectsOf :hasTemplate , :usesRenderer ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [
        sh:path :hasTemplate ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ; sh:class :StatementTemplate
    ] ;
    sh:property [
        sh:path :usesRenderer ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ; sh:class :TemplateRenderer
    ] ;
    sh:property [
        sh:path :sparql ; sh:maxCount 0 ;
        sh:message "A template implementation supplies source through hasTemplate; executable SPARQL is produced during rendering."@en
    ] ;
    sh:property [
        sh:path :fileName ; sh:maxCount 0 ;
        sh:message "A template source file belongs to the linked StatementTemplate through templateFileName."@en
    ] ;
    sh:sparql [
        sh:message "The selected renderer must explicitly support the template document's declared language/profile."@en ;
        sh:select """
            SELECT $this WHERE {
                $this <https://ekgf.org/ontology/story-impl-sparql#hasTemplate> ?template ;
                      <https://ekgf.org/ontology/story-impl-sparql#usesRenderer> ?renderer .
                ?template <https://ekgf.org/ontology/concept#templateLanguage> ?language .
                FILTER NOT EXISTS {
                    ?renderer <https://ekgf.org/ontology/story-impl-sparql#supportsTemplateLanguage> ?language .
                }
            }
        """
    ] ;
    rdfs:label "Story SPARQL Template Implementation Shape"@en ;
    rdfs:comment "Requires one template and one renderer with matching language support, and rejects mixing template source with executable-SPARQL source fields."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/story-impl-sparql#> .

<https://ekgf.org/ontology/story-impl-sparql#> annotation:markdownDescription """
# Source language, renderer, and generated SPARQL

A direct SPARQL implementation supplies executable query/update source with
`sparql` or `fileName`. A `StorySPARQLTemplateImplementation` instead uses
`hasTemplate` to identify a `StatementTemplate` and `usesRenderer` to identify
the selected `TemplateRenderer`.

The template document supplies `templateText`, `templateFileName`, or both,
and exactly one `concept:templateLanguage` profile. Its source is interpreted
in that language. The renderer must explicitly declare matching
`supportsTemplateLanguage` metadata. An execution service must also approve
that profile and renderer; metadata alone does not certify safe execution.

Rendering supplies validated story input values to the template and produces
a SPARQL statement for that invocation. This output is parsed and validated
before execution. It is a different artifact from the reusable template
document and is not stored in the template implementation's native-source
fields. The implementation still belongs to exactly one story.

An input concept's placeholder is a `concept:TemplateParameterManifestation`
with its own declared template language. A native query variable is a
`concept:SPARQLVariableManifestation`. The source format and role determine
the distinction: a dollar token can be native SPARQL syntax too, so a parser
accepting unexpanded template text does not authorize executing it.

`StatementTemplateShape`, `TemplateRendererShape`, and
`StorySPARQLTemplateImplementationShape` validate these relationships. Load
the local Concept and Story shapes as well when validating the full model.
All entry shapes belong to this ontology's `ValidationShapeSet`.

See the repository's
[template processing guide](https://github.com/EKGF/ekg-ontologies/blob/main/docs/story-concept-usages.md#template-processing-contract)
for input serialization requirements and an executable metadata example.
"""@en .

<https://ekgf.org/ontology/story-impl-sparql#> a sh:ShapesGraph .

:ValidationShapeSet a owl:NamedIndividual , ekg-shape:ShapeSet ;
    ekg-shape:hasShapesGraph <https://ekgf.org/ontology/story-impl-sparql#> ;
    rdfs:label "SPARQL Story Implementation Validation Shapes"@en ;
    rdfs:comment "Validates template documents, renderer language capabilities, and template-based SPARQL story implementations."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/story-impl-sparql#> ;
    ekg-shape:shapePurpose ekg-shape:Validation ;
    ekg-shape:hasShape :StatementTemplateShape ,
                       :TemplateRendererShape ,
                       :StorySPARQLTemplateImplementationShape .
