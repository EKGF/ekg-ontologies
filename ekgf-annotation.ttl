@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix annotation: <https://ekgf.org/ontology/annotation#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ekg-annotation: <https://ekgf.org/ontology/annotation#> .
@base <https://ekgf.org/ontology/annotation#> .

<https://ekgf.org/ontology/annotation#>
    rdf:type owl:Ontology ;
    sh:declare [
        sh:prefix "ekg-annotation" ;
        sh:namespace "https://ekgf.org/ontology/annotation#"^^xsd:anyURI
    ] ;
    rdfs:label "Annotation Ontology"@en ;
    rdfs:comment "Descriptive resource metadata: Markdown descriptions, subtitles, summaries, short titles, URL slugs, colors and sort keys. Text annotations apply to classes, properties and individuals; slug and sortKey are datatype properties for resource addressing and ordering."@en .

annotation:slug a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "slug"@en ;
    rdfs:comment "The short, lowercase, hyphenated name by which a resource is addressed in a URL."@en ;
    rdfs:isDefinedBy annotation: ;
    annotation:markdownDescription """
A slug is a readable URL name, such as `enterprise` or `working-draft`.
It does not replace the resource's stable IRI or registered UUID identity.
Different contexts can reuse a slug: states in different lifecycles can both
be named `deprecated`. This property declares no global uniqueness rule,
cardinality restriction or automatic slug generation.

The property is an `owl:DatatypeProperty` with string values. Its placement in
this ontology does not turn it into an OWL annotation property. The existing
Markdown, subtitle and summary predicates retain their annotation semantics.
"""@en .

#################################################################
#    Annotation properties
#################################################################

annotation:markdownDescription rdf:type owl:AnnotationProperty ;
    rdfs:label "Markdown description"@en ;
    rdfs:comment "A description of the resource, written in Markdown. Where it is absent, rdfs:comment is the description."@en .

annotation:subtitle rdf:type owl:AnnotationProperty ;
    rdfs:label "subtitle"@en ;
    rdfs:comment "One line shown under the label of the resource."@en .

annotation:summary rdf:type owl:AnnotationProperty ;
    rdfs:label "summary"@en ;
    rdfs:comment "A short summary of the resource, in plain text."@en .

annotation:hexColor rdf:type owl:AnnotationProperty ;
    rdfs:label "Hexadecimal RGB color"@en ;
    rdfs:comment "An RGB color code in hex"@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/annotation#> .

annotation:sortKey rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Sort key"@en ;
    rdfs:comment "What a resource sorts by among its siblings, in place of its label. A resource without one sorts by its label, and siblings sharing a key are in the order of their labels. A key is a hint, not a rank."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/annotation#> ;
    annotation:markdownDescription """
A sort key places a resource among its siblings wherever a user interface or
report lists them: use cases in a tree, concepts in a vocabulary, tabs on a
page. Sorting compares the key where a resource has one and its label where it
does not, so keys compete with the labels themselves.

A key is a hint, not a rank. Siblings often come from datasets and sources that
know nothing of each other, so they cannot share a numbering. Each source picks
an arbitrary string that lands its resource roughly in the right place: "aaa"
near the start, "zzz" near the end. Two resources with the same key sit side by
side and sort by their labels instead of colliding.

```turtle
@prefix annotation: <https://ekgf.org/ontology/annotation#> .
@prefix ex: <https://example.org/> .

ex:overview annotation:sortKey "aaa" .
ex:shapes annotation:sortKey "zzz1" .
ex:provenance annotation:sortKey "zzz2" .
```

The property has no domain, so any resource can carry one. Its placement in
this ontology does not make it an OWL annotation property; like `slug`, it is a
datatype property with string values.
"""@en .

annotation:shortTitle rdf:type owl:AnnotationProperty ;
    rdfs:label "short title"@en ;
    rdfs:comment "A shorter name for the resource, for places where the surrounding context already supplies the rest, such as an ontology listed under its family heading. One value per language."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/annotation#> ;
    annotation:markdownDescription """
A short title is a real, authored name, not the result of trimming a title. For
example, "Commons Identifiers Ontology" can have the short title "Identifiers
Ontology" for use under the Commons family heading. A viewer chooses the short
title where the context makes the full title redundant, and the full label
elsewhere.

Each value carries a language tag, with at most one short title per language,
so translations work like any other label. Resources without a short title use
their normal label. A tool that knows a naming convention can generate short
titles, and `ShortTitleShape` validates them like any other data.
"""@en .

#################################################################
#    Validation
#################################################################

annotation:ShortTitleShape a sh:NodeShape ;
    sh:targetSubjectsOf annotation:shortTitle ;
    sh:property [
        sh:path annotation:shortTitle ;
        sh:datatype rdf:langString ;
        sh:minLength 1 ;
        sh:uniqueLang true ;
        sh:message "A short title is a nonempty language-tagged string, with at most one per language."@en
    ] ;
    rdfs:label "Short Title Shape"@en ;
    rdfs:comment "Requires each short title to be a nonempty language-tagged literal, with at most one per language."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/annotation#> .

<https://ekgf.org/ontology/annotation#> a sh:ShapesGraph .

#################################################################
#    Documentation annotations
#################################################################

<https://ekgf.org/ontology/annotation#>
