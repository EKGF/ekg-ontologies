@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix annotation: <https://ekgf.org/ontology/annotation#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ekg-annotation: <https://ekgf.org/ontology/annotation#> .
@base <https://ekgf.org/ontology/annotation#> .

<https://ekgf.org/ontology/annotation#>
    rdf:type owl:Ontology ;
    sh:declare [
        sh:prefix "ekg-annotation" ;
        sh:namespace "https://ekgf.org/ontology/annotation#"^^xsd:anyURI
    ] ;
    rdfs:label "Annotation Ontology"@en ;
    rdfs:comment "Descriptive resource metadata: Markdown descriptions, subtitles, summaries and URL slugs. Text annotations apply to classes, properties and individuals; slug is a datatype property for resource addressing."@en .

annotation:slug a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "slug"@en ;
    rdfs:comment "The short, lowercase, hyphenated name by which a resource is addressed in a URL."@en ;
    rdfs:isDefinedBy annotation: ;
    annotation:markdownDescription """
A slug is a readable URL name, such as `enterprise` or `working-draft`.
It does not replace the resource's stable IRI or registered UUID identity.
Different contexts can reuse a slug: states in different lifecycles can both
be named `deprecated`. This property declares no global uniqueness rule,
cardinality restriction or automatic slug generation.

The property is an `owl:DatatypeProperty` with string values. Its placement in
this ontology does not turn it into an OWL annotation property. The existing
Markdown, subtitle and summary predicates retain their annotation semantics.
"""@en .

#################################################################
#    Annotation properties
#################################################################

annotation:markdownDescription rdf:type owl:AnnotationProperty ;
    rdfs:label "Markdown description"@en ;
    rdfs:comment "A description of the resource, written in Markdown. Where it is absent, rdfs:comment is the description."@en .

annotation:subtitle rdf:type owl:AnnotationProperty ;
    rdfs:label "subtitle"@en ;
    rdfs:comment "One line shown under the label of the resource."@en .

annotation:summary rdf:type owl:AnnotationProperty ;
    rdfs:label "summary"@en ;
    rdfs:comment "A short summary of the resource, in plain text."@en .


#################################################################
#    Documentation annotations
#################################################################

<https://ekgf.org/ontology/annotation#>
    <http://purl.org/dc/terms/license> <https://creativecommons.org/publicdomain/zero/1.0/> .

<https://ekgf.org/ontology/annotation#markdownDescription>
    rdfs:isDefinedBy <https://ekgf.org/ontology/annotation#> ;
    annotation:markdownDescription """
Use this annotation on an ontology, class, property, or individual for
explanations that benefit from Markdown: scope, examples, modeling decisions,
ownership rules, and application behavior. Use an English language tag for the
English explanation. Keep a short definition in `rdfs:comment` where useful.

Markdown can include headings, lists, tables, fenced code examples, and links.
Consumers render this description when present and use `rdfs:comment` when it
is absent.

An explanation is an annotation. Describing a subclass relationship, a property
range, a SHACL constraint, or an application default does not implement it.
Identify agreed changes awaiting implementation explicitly, so readers can
distinguish the recorded decision from the current axioms.
"""@en .

<https://ekgf.org/ontology/annotation#subtitle>
    rdfs:isDefinedBy <https://ekgf.org/ontology/annotation#> .

<https://ekgf.org/ontology/annotation#summary>
    rdfs:isDefinedBy <https://ekgf.org/ontology/annotation#> .
