@prefix : <https://ekgf.org/ontology/story#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obda: <https://w3id.org/obda/vocabulary#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix concept: <https://ekgf.org/ontology/concept#> .
@prefix outcome: <https://ekgf.org/ontology/outcome#> .
@prefix persona: <https://ekgf.org/ontology/persona#> .
@prefix story-svc: <https://ekgf.org/ontology/ekg-platform-story-service#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ekg-story: <https://ekgf.org/ontology/story#> .
@prefix ekg-shape: <https://ekgf.org/ontology/shape#> .
@prefix annotation: <https://ekgf.org/ontology/annotation#> .

<https://ekgf.org/ontology/story#> a owl:Ontology ;
  sh:declare [
      sh:prefix "ekg-story" ;
      sh:namespace "https://ekgf.org/ontology/story#"^^xsd:anyURI
  ] ;
	owl:imports <https://ekgf.org/ontology/persona#> , <https://ekgf.org/ontology/concept#> , <https://ekgf.org/ontology/outcome#> , ekg-shape: ;
	rdfs:comment "The EKGF Story Ontology"@en ;
	rdfs:label "Story Ontology"@en .
# 
# 
# #################################################################
# #
# #    Annotation properties
# #
# #################################################################
# 
# 
# http://purl.org/dc/elements/1.1/creator

<http://purl.org/dc/elements/1.1/creator> a owl:AnnotationProperty .
# 
# http://purl.org/dc/elements/1.1/date

<http://purl.org/dc/elements/1.1/date> a owl:AnnotationProperty .
# 
# 
# 
# #################################################################
# #
# #    Object Properties
# #
# #################################################################
# 
# 
# https://ekgf.org/ontology/concept#hasConcept

concept:hasConcept rdfs:domain _:genid1 .

_:genid1 a owl:Class ;
	owl:unionOf _:genid3 .

_:genid3 a rdf:List ;
	rdf:first :StoryInput ;
	rdf:rest _:genid2 .

_:genid2 a rdf:List ;
	rdf:first :StoryOutput ;
	rdf:rest rdf:nil .
# 
# https://ekgf.org/ontology/story#hasInput

:hasInput a owl:ObjectProperty , owl:InverseFunctionalProperty ;
	rdfs:domain :Story ;
	rdfs:range :StoryInput ;
	<http://purl.org/dc/elements/1.1/creator> <http://orcid.org/0000-0003-2309-5068> ;
	<http://purl.org/dc/elements/1.1/date> "2020-04-28T13:27:52Z"^^xsd:dateTime ;
	rdfs:comment "An Input Parameter links a data element concept to a Story as one of its inputs"@en ;
	rdfs:label "has input parameter"@en .
# 
# https://ekgf.org/ontology/story#hasOutput

:hasOutput a owl:ObjectProperty , owl:InverseFunctionalProperty ;
	rdfs:domain :Story ;
	rdfs:range :StoryOutput ;
	<http://purl.org/dc/elements/1.1/creator> <http://orcid.org/0000-0003-2309-5068> ;
	<http://purl.org/dc/elements/1.1/date> "2020-04-28T18:48:14Z"^^xsd:dateTime .
# 
# https://ekgf.org/ontology/story#implementationOf

:implementationOf a owl:ObjectProperty , owl:FunctionalProperty ;
	owl:inverseOf :implementedBy ;
	rdfs:domain :StoryImplementation ;
	rdfs:range :Story ;
	<http://purl.org/dc/elements/1.1/creator> <http://orcid.org/0000-0003-2309-5068> ;
	<http://purl.org/dc/elements/1.1/date> "2026-02-23T00:00:00Z"^^xsd:dateTime ;
	rdfs:label "implementation of"@en .
# 
# https://ekgf.org/ontology/story#hasInputConcept

:hasInputConcept a owl:ObjectProperty ;
	rdfs:domain :Story ;
	rdfs:range concept:DataElementConcept ;
	<http://purl.org/dc/elements/1.1/creator> <http://orcid.org/0000-0003-2309-5068> ;
	<http://purl.org/dc/elements/1.1/date> "2026-02-23T00:00:00Z"^^xsd:dateTime ;
	rdfs:comment "Direct projection of the input concepts required by the Story."@en ;
	rdfs:label "has input concept"@en .
# 
# https://ekgf.org/ontology/story#hasOutputConcept

:hasOutputConcept a owl:ObjectProperty ;
	rdfs:domain :Story ;
	rdfs:range concept:DataElementConcept ;
	<http://purl.org/dc/elements/1.1/creator> <http://orcid.org/0000-0003-2309-5068> ;
	<http://purl.org/dc/elements/1.1/date> "2026-02-23T00:00:00Z"^^xsd:dateTime ;
	rdfs:comment "Direct projection of the output concepts produced by the Story."@en ;
	rdfs:label "has output concept"@en .
# 
# https://ekgf.org/ontology/story#hasDependentConcept

:hasDependentConcept a owl:ObjectProperty ;
	rdfs:domain :Story ;
	rdfs:range concept:DataElementConcept ;
	<http://purl.org/dc/elements/1.1/creator> <http://orcid.org/0000-0003-2309-5068> ;
	<http://purl.org/dc/elements/1.1/date> "2026-02-23T00:00:00Z"^^xsd:dateTime ;
	rdfs:comment "Concepts referenced by implementation logic (for example discovered from statement algebra)."@en ;
	rdfs:label "has dependent concept"@en .
# 
# https://ekgf.org/ontology/story#playedBy

:playedBy a owl:ObjectProperty , owl:FunctionalProperty ;
	rdfs:domain :Story ;
	rdfs:range persona:Persona ;
	<http://purl.org/dc/elements/1.1/creator> <http://orcid.org/0000-0003-2309-5068> ;
	<http://purl.org/dc/elements/1.1/date> "2020-04-01T18:12:45Z"^^xsd:dateTime .
# 
