<https://ekgf.org/ontology/story#AgentJobImplementation>
    rdfs:comment "A story implementation expressed as a job performed by an agent."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/story#> .

<https://ekgf.org/ontology/story#ApiProxyImplementation>
    rdfs:comment "A story implementation that delegates the interaction to an API through a proxy."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/story#> .

