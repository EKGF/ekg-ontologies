# 
# #################################################################
# #
# #    Data properties
# #
# #################################################################
# 
# 
# https://ekgf.org/ontology/story#isPlural

:isPlural a owl:DatatypeProperty , owl:FunctionalProperty ;
	rdfs:domain :Story ;
	rdfs:range xsd:boolean ;
	owl:propertyDisjointWith :isSingular ;
	<http://purl.org/dc/elements/1.1/creator> <http://orcid.org/0000-0003-2309-5068> ;
	<http://purl.org/dc/elements/1.1/date> "2020-05-06T09:38:46Z"^^xsd:dateTime ;
	rdfs:comment "Do not use, use isSingular"@en .
# 
# https://ekgf.org/ontology/story#isSingular

:isSingular a owl:DatatypeProperty , owl:FunctionalProperty ;
	rdfs:domain :Story ;
	rdfs:range xsd:boolean ;
	<http://purl.org/dc/elements/1.1/creator> <http://orcid.org/0000-0003-2309-5068> ;
	<http://purl.org/dc/elements/1.1/date> "2020-05-06T09:37:47Z"^^xsd:dateTime ;
	rdfs:comment "Means that the user story results in a singular Thing as its output"@en .
# 
# https://ekgf.org/ontology/story#isUpdate

:isUpdate a owl:DatatypeProperty , owl:FunctionalProperty ;
	rdfs:domain :Story ;
	rdfs:range xsd:boolean ;
	<http://purl.org/dc/elements/1.1/creator> <http://orcid.org/0000-0003-2309-5068> ;
	<http://purl.org/dc/elements/1.1/date> "2020-05-06T09:37:47Z"^^xsd:dateTime ;
	rdfs:comment "Means that the user story mutates the database by insert or delete statements"@en .
# 
# https://ekgf.org/ontology/story#serverProvidedIRI

:serverProvidedIRI a owl:DatatypeProperty , owl:FunctionalProperty ;
	rdfs:domain :Story ;
	rdfs:range xsd:boolean ;
	<http://purl.org/dc/elements/1.1/creator> <http://orcid.org/0000-0003-2309-5068> ;
	<http://purl.org/dc/elements/1.1/date> "2020-04-07T20:48:22Z"^^xsd:dateTime ;
	rdfs:comment "indicates that, if provided and if true, the Story Service needs to provide a KGIRI as the value for this input parameter."@en .
# 
# https://ekgf.org/ontology/story#implementationType

:implementationType a owl:DatatypeProperty , owl:FunctionalProperty ;
	rdfs:domain :StoryImplementation ;
	rdfs:range xsd:token ;
	<http://purl.org/dc/elements/1.1/creator> <http://orcid.org/0000-0003-2309-5068> ;
	<http://purl.org/dc/elements/1.1/date> "2026-02-23T00:00:00Z"^^xsd:dateTime ;
	rdfs:comment "Coarse implementation type. Supported values: NamedStatement, ApiProxy, Workflow, AgentJob, Pipeline, UiAction."@en .
# 
