# 
# 
# https://ekgf.org/ontology/outcome#Outcome

outcome:Outcome a owl:Class .
# 
# https://ekgf.org/ontology/persona#Persona

persona:Persona a owl:Class .
# 
# https://ekgf.org/ontology/story#StoryConceptUsage

:StoryStereoType a owl:Class ;
    owl:disjointWith :Story , :StoryImplementation , :StoryConceptUsage ;
    rdfs:label "Story Stereotype"@en ;
    rdfs:comment "An extensible classification identifying a story's primary purpose. A stereotype is a reusable classification individual, distinct from stories, implementations, and concept usages. Its identity is an IRI with a label and a meaningful definition."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/story#> .

:StoryConceptUsage a owl:Class ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty [ owl:inverseOf :hasConceptUsage ] ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] , [
        a owl:Restriction ;
        owl:onProperty [ owl:inverseOf :hasConceptUsage ] ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] , [
        a owl:Restriction ;
        owl:onProperty concept:hasConcept ;
        owl:minCardinality "1"^^xsd:nonNegativeInteger
    ] , [
        a owl:Restriction ;
        owl:onProperty concept:hasConcept ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger
    ] ;
    owl:disjointWith :Story , concept:DataElementConcept , concept:ConceptManifestation ;
    rdfs:label "Story Concept Usage"@en ;
    rdfs:comment "A story-owned relationship object with exactly one owning story and exactly one referenced data element concept. Its input, output, or dependent role describes the usage, not the reusable concept."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/story#> .
# 
# https://ekgf.org/ontology/story#StoryInput

:StoryInput a owl:Class ;
    rdfs:subClassOf :StoryConceptUsage ;
    owl:disjointWith :StoryOutput , :StoryDependent ;
	<http://purl.org/dc/elements/1.1/creator> <http://orcid.org/0000-0003-2309-5068> ;
	<http://purl.org/dc/elements/1.1/date> "2020-04-01T17:24:36Z"^^xsd:dateTime ;
	rdfs:comment "A story-owned input-concept usage referencing one reusable data element concept. Requiredness and server provision belong to this usage."@en .
# 
# https://ekgf.org/ontology/story#StoryOutput

:StoryOutput a owl:Class ;
    rdfs:subClassOf :StoryConceptUsage ;
    owl:disjointWith :StoryDependent ;
	<http://purl.org/dc/elements/1.1/creator> <http://orcid.org/0000-0003-2309-5068> ;
	<http://purl.org/dc/elements/1.1/date> "2020-04-07T20:40:12Z"^^xsd:dateTime ;
	rdfs:comment "A story-owned output-concept usage referencing one reusable data element concept produced by the story, including compound output meanings."@en .

:StoryDependent a owl:Class ;
    rdfs:subClassOf :StoryConceptUsage ;
    rdfs:label "Story Dependent"@en ;
    rdfs:comment "A story-owned dependent-concept usage referencing one reusable data element concept used internally without exposing it as an input or output."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/story#> .
# 
# https://ekgf.org/ontology/story#StoryImplementation

:StoryImplementation a owl:Class ;
	rdfs:subClassOf [
		a owl:Restriction ;
		owl:onProperty :implementationOf ;
		owl:cardinality "1"^^xsd:nonNegativeInteger
	] ;
	rdfs:comment "An executable implementation artifact belonging to exactly one Story. A Story can have zero or more implementations."@en ;
	rdfs:label "Story Implementation"@en .
# 
# https://ekgf.org/ontology/story#NamedStatementImplementation

:NamedStatementImplementation a owl:Class ;
	rdfs:subClassOf :StoryImplementation ;
	rdfs:label "Named Statement Implementation"@en .
# 
# https://ekgf.org/ontology/story#ApiProxyImplementation

:ApiProxyImplementation a owl:Class ;
	rdfs:subClassOf :StoryImplementation ;
	rdfs:label "API Proxy Implementation"@en .
# 
# https://ekgf.org/ontology/story#WorkflowImplementation

:WorkflowImplementation a owl:Class ;
	rdfs:subClassOf :StoryImplementation ;
	rdfs:label "Workflow Implementation"@en .
# 
# https://ekgf.org/ontology/story#AgentJobImplementation

:AgentJobImplementation a owl:Class ;
	rdfs:subClassOf :StoryImplementation ;
	rdfs:label "Agent Job Implementation"@en .
# 
# https://ekgf.org/ontology/story#contributesTo

:contributesTo a owl:ObjectProperty ;
	rdfs:domain :Story ;
	rdfs:range outcome:Outcome ;
	rdfs:label "contributes to"@en ;
	rdfs:comment "The business outcome this story contributes to."@en .
# 
# https://ekgf.org/ontology/story#implementedBy

:implementedBy a owl:ObjectProperty ;
	rdfs:domain :Story ;
	rdfs:range :StoryImplementation ;
	rdfs:label "implemented by"@en ;
	rdfs:comment "Links a story to one of its implementations; inverse of implementationOf. A story can have zero or more implementations, and each implementation belongs to exactly one story. Execution selection is a Story Service responsibility."@en .
# 
# https://ekgf.org/ontology/story#providedBy

:providedBy a owl:ObjectProperty ;
	rdfs:domain :Story ;
	rdfs:label "provided by"@en ;
	rdfs:comment "The provider a story is supplied by. No range is asserted: every assertion in the corpus points at a resource the corpus does not define, so the intended class is not evidenced."@en .
# 
# https://ekgf.org/ontology/story#notFoundOnEmpty

:notFoundOnEmpty a owl:DatatypeProperty , owl:FunctionalProperty ;
	rdfs:domain :Story ;
	rdfs:range xsd:boolean ;
	rdfs:label "not found on empty"@en ;
	rdfs:comment "A singular story that returns no rows answers 404 rather than an empty object."@en .
# 
# https://ekgf.org/ontology/story#isDeletion

:isDeletion a owl:DatatypeProperty , owl:FunctionalProperty ;
	rdfs:domain :Story ;
	rdfs:range xsd:boolean ;
	rdfs:label "is deletion"@en ;
	rdfs:comment "The story deletes. It is invoked by DELETE, and refuses a GET; how a story mutates is a property of the story, never a subclass of it."@en .
# 
# https://ekgf.org/ontology/story#Story

:Story a owl:Class ;
    owl:disjointWith :StoryImplementation ;
	rdfs:label "Story"@en .
