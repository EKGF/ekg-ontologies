# 
# https://ekgf.org/ontology/story#hasConceptUsage

:hasStereoType a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Story ;
    rdfs:range :StoryStereoType ;
    rdfs:label "has stereotype"@en ;
    rdfs:comment "Assigns a story's optional primary-purpose classification. A story has at most one stereotype; no default is inferred. Stereotypes classify the story's intent independently of implementation language, mechanism, and mutation flags."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/story#> .

:hasConceptUsage a owl:ObjectProperty , owl:InverseFunctionalProperty ;
    rdfs:domain :Story ;
    rdfs:range :StoryConceptUsage ;
    rdfs:label "has concept usage"@en ;
    rdfs:comment "Links a story to a concept-usage object owned by that story. Different stories use separate usage objects when referencing the same reusable concept."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/story#> .
# 
# https://ekgf.org/ontology/story#implementationOf

:implementationOf a owl:ObjectProperty , owl:FunctionalProperty ;
	owl:inverseOf :implementedBy ;
	rdfs:domain :StoryImplementation ;
	rdfs:range :Story ;
	<http://purl.org/dc/elements/1.1/creator> <http://orcid.org/0000-0003-2309-5068> ;
	<http://purl.org/dc/elements/1.1/date> "2026-02-23T00:00:00Z"^^xsd:dateTime ;
	rdfs:label "implementation of"@en .
# 
# https://ekgf.org/ontology/story#hasInputConcept

:hasInputConcept a owl:ObjectProperty ;
	rdfs:subPropertyOf :hasConceptUsage ;
	rdfs:domain :Story ;
	rdfs:range :StoryInput ;
	<http://purl.org/dc/elements/1.1/creator> <http://orcid.org/0000-0003-2309-5068> ;
	<http://purl.org/dc/elements/1.1/date> "2026-02-23T00:00:00Z"^^xsd:dateTime ;
	rdfs:comment "Links a story to its input-concept usage. The usage references a shared data element concept through concept:hasConcept and carries the story's input requirements."@en ;
	rdfs:label "has input concept"@en .
# 
# https://ekgf.org/ontology/story#hasOutputConcept

:hasOutputConcept a owl:ObjectProperty ;
	rdfs:subPropertyOf :hasConceptUsage ;
	rdfs:domain :Story ;
	rdfs:range :StoryOutput ;
	<http://purl.org/dc/elements/1.1/creator> <http://orcid.org/0000-0003-2309-5068> ;
	<http://purl.org/dc/elements/1.1/date> "2026-02-23T00:00:00Z"^^xsd:dateTime ;
	rdfs:comment "Links a story to an output-concept usage referencing the shared data element concept produced by the story."@en ;
	rdfs:label "has output concept"@en .
# 
# https://ekgf.org/ontology/story#hasDependentConcept

:hasDependentConcept a owl:ObjectProperty ;
	rdfs:subPropertyOf :hasConceptUsage ;
	rdfs:domain :Story ;
	rdfs:range :StoryDependent ;
	<http://purl.org/dc/elements/1.1/creator> <http://orcid.org/0000-0003-2309-5068> ;
	<http://purl.org/dc/elements/1.1/date> "2026-02-23T00:00:00Z"^^xsd:dateTime ;
	rdfs:comment "Links a story to a dependent-concept usage referencing a shared data element concept used internally rather than exposed as an input or output."@en ;
	rdfs:label "has dependent concept"@en .
# 
# https://ekgf.org/ontology/story#playedBy

:playedBy a owl:ObjectProperty , owl:FunctionalProperty ;
	rdfs:domain :Story ;
	rdfs:range persona:Persona ;
	<http://purl.org/dc/elements/1.1/creator> <http://orcid.org/0000-0003-2309-5068> ;
	<http://purl.org/dc/elements/1.1/date> "2020-04-01T18:12:45Z"^^xsd:dateTime .
