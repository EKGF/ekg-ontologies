# https://ekgf.org/ontology/concept#hasConcept

concept:hasConcept rdfs:domain _:genid1 .

_:genid1 a owl:Class ;
	owl:unionOf _:genid3 .

_:genid3 a rdf:List ;
	rdf:first :StoryInput ;
	rdf:rest _:genid2 .

_:genid2 a rdf:List ;
	rdf:first :StoryOutput ;
	rdf:rest rdf:nil .
# 
# https://ekgf.org/ontology/story#hasInput

:hasInput a owl:ObjectProperty , owl:InverseFunctionalProperty ;
	rdfs:domain :Story ;
	rdfs:range :StoryInput ;
	<http://purl.org/dc/elements/1.1/creator> <http://orcid.org/0000-0003-2309-5068> ;
	<http://purl.org/dc/elements/1.1/date> "2020-04-28T13:27:52Z"^^xsd:dateTime ;
	rdfs:comment "An Input Parameter links a Concept to a Story as one of its inputs"@en ;
	rdfs:label "has input parameter"@en .
# 
# https://ekgf.org/ontology/story#hasOutput

:hasOutput a owl:ObjectProperty , owl:InverseFunctionalProperty ;
	rdfs:domain :Story ;
	rdfs:range :StoryOutput ;
	<http://purl.org/dc/elements/1.1/creator> <http://orcid.org/0000-0003-2309-5068> ;
	<http://purl.org/dc/elements/1.1/date> "2020-04-28T18:48:14Z"^^xsd:dateTime .
# 
# https://ekgf.org/ontology/story#hasImplementation

:hasImplementation a owl:ObjectProperty ;
	rdfs:domain :Story ;
	rdfs:range :StoryImplementation ;
	<http://purl.org/dc/elements/1.1/creator> <http://orcid.org/0000-0003-2309-5068> ;
	<http://purl.org/dc/elements/1.1/date> "2026-02-23T00:00:00Z"^^xsd:dateTime ;
	rdfs:comment "Links a Story to zero or more StoryImplementations."@en ;
	rdfs:label "has implementation"@en .
# 
# https://ekgf.org/ontology/story#implementationOf

:implementationOf a owl:ObjectProperty ;
	owl:inverseOf :hasImplementation ;
	rdfs:domain :StoryImplementation ;
	rdfs:range :Story ;
	<http://purl.org/dc/elements/1.1/creator> <http://orcid.org/0000-0003-2309-5068> ;
	<http://purl.org/dc/elements/1.1/date> "2026-02-23T00:00:00Z"^^xsd:dateTime ;
	rdfs:label "implementation of"@en .
# 
# https://ekgf.org/ontology/story#hasInputConcept

:hasInputConcept a owl:ObjectProperty ;
	rdfs:domain :Story ;
	rdfs:range concept:Concept ;
	<http://purl.org/dc/elements/1.1/creator> <http://orcid.org/0000-0003-2309-5068> ;
	<http://purl.org/dc/elements/1.1/date> "2026-02-23T00:00:00Z"^^xsd:dateTime ;
	rdfs:comment "Direct projection of the input concepts required by the Story."@en ;
	rdfs:label "has input concept"@en .
# 
# https://ekgf.org/ontology/story#hasOutputConcept

:hasOutputConcept a owl:ObjectProperty ;
	rdfs:domain :Story ;
	rdfs:range concept:Concept ;
	<http://purl.org/dc/elements/1.1/creator> <http://orcid.org/0000-0003-2309-5068> ;
	<http://purl.org/dc/elements/1.1/date> "2026-02-23T00:00:00Z"^^xsd:dateTime ;
	rdfs:comment "Direct projection of the output concepts produced by the Story."@en ;
	rdfs:label "has output concept"@en .
# 
# https://ekgf.org/ontology/story#hasDependentConcept

:hasDependentConcept a owl:ObjectProperty ;
	rdfs:domain :Story ;
	rdfs:range concept:Concept ;
	<http://purl.org/dc/elements/1.1/creator> <http://orcid.org/0000-0003-2309-5068> ;
	<http://purl.org/dc/elements/1.1/date> "2026-02-23T00:00:00Z"^^xsd:dateTime ;
	rdfs:comment "Concepts referenced by implementation logic (for example discovered from statement algebra)."@en ;
	rdfs:label "has dependent concept"@en .
# 
# https://ekgf.org/ontology/story#playedBy

:playedBy a owl:ObjectProperty , owl:FunctionalProperty ;
	rdfs:domain :Story ;
	rdfs:range persona:Persona ;
	<http://purl.org/dc/elements/1.1/creator> <http://orcid.org/0000-0003-2309-5068> ;
	<http://purl.org/dc/elements/1.1/date> "2020-04-01T18:12:45Z"^^xsd:dateTime .
