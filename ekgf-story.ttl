#################################################################
#    Story stereotypes
#################################################################

:StoryStereoTypeQuery a owl:NamedIndividual , :StoryStereoType ;
    owl:differentFrom :StoryStereoTypeUpdate , :StoryStereoTypeTransformationRule ,
                      :StoryStereoTypeValidationRule ;
    rdfs:label "Query"@en ;
    rdfs:comment "A story whose primary purpose is to retrieve or present information. This classification does not select a query language, implementation mechanism, or mutation-flag value."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/story#> .

:StoryStereoTypeUpdate a owl:NamedIndividual , :StoryStereoType ;
    owl:differentFrom :StoryStereoTypeTransformationRule , :StoryStereoTypeValidationRule ;
    rdfs:label "Update"@en ;
    rdfs:comment "A story whose primary purpose is to apply an explicitly requested change to data. This describes the intended action, independently of the implementation technology and separately recorded mutation flags."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/story#> .

:StoryStereoTypeTransformationRule a owl:NamedIndividual , :StoryStereoType ;
    owl:differentFrom :StoryStereoTypeValidationRule ;
    rdfs:label "Transformation Rule"@en ;
    rdfs:comment "A story whose primary purpose is to derive or transform data according to a rule. This does not require SHACL, SPARQL, or any particular rule engine, and does not specify whether derived data is persisted."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/story#> .

:StoryStereoTypeValidationRule a owl:NamedIndividual , :StoryStereoType ;
    rdfs:label "Validation Rule"@en ;
    rdfs:comment "A story whose primary purpose is to assess data against requirements and report conformance or violations. The classification does not determine whether the implementation uses SHACL constraints, a query, an API, or another mechanism."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/story#> .

#################################################################
#    Story validation
#################################################################

:StoryClassificationShape a sh:NodeShape ;
    sh:targetClass :Story ;
    sh:targetSubjectsOf :hasStereoType ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:not [
        sh:or (
            [ sh:class :StoryImplementation ]
            [ sh:class :StoryConceptUsage ]
            [ sh:class :StoryStereoType ]
        )
    ] ;
    sh:property [
        sh:path :hasStereoType ; sh:maxCount 1 ;
        sh:nodeKind sh:IRI ; sh:class :StoryStereoType ;
        sh:message "A story may have at most one primary-purpose stereotype, identified by an IRI."@en
    ] ;
    rdfs:label "Story Classification Shape"@en ;
    rdfs:comment "Validates optional primary-purpose classification on stories, rejecting multiple stereotype terms, nonresource stories, and classification assigned to implementations, concept usages, or stereotype resources."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/story#> .

:StoryStereoTypeShape a sh:NodeShape ;
    sh:targetClass :StoryStereoType ;
    sh:targetObjectsOf :hasStereoType ;
    sh:nodeKind sh:IRI ;
    sh:not [
        sh:or (
            [ sh:class :Story ]
            [ sh:class :StoryImplementation ]
            [ sh:class :StoryConceptUsage ]
        )
    ] ;
    sh:property [
        sh:path rdfs:label ; sh:minCount 1 ; sh:nodeKind sh:Literal ; sh:minLength 1
    ] ;
    sh:property [
        sh:path rdfs:comment ; sh:nodeKind sh:Literal ; sh:minLength 1
    ] ;
    sh:property [
        sh:path annotation:markdownDescription ; sh:nodeKind sh:Literal ; sh:minLength 1
    ] ;
    sh:or (
        [ sh:property [ sh:path rdfs:comment ; sh:minCount 1 ] ]
        [ sh:property [ sh:path annotation:markdownDescription ; sh:minCount 1 ] ]
    ) ;
    rdfs:label "Story Stereotype Shape"@en ;
    rdfs:comment "Requires a stereotype IRI, a nonempty literal label, and a nonempty literal definition in rdfs:comment or markdownDescription. Covers built-in and application-defined stereotypes, including subclasses; the vocabulary is not a closed enumeration."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/story#> .

:StoryConceptUsageShape a sh:NodeShape ;
    sh:targetClass :StoryConceptUsage ;
    sh:targetObjectsOf :hasConceptUsage , :hasInputConcept , :hasOutputConcept , :hasDependentConcept ;
    sh:targetSubjectsOf :isMandatory , :isServerProvided ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:xone (
        [ sh:class :StoryInput ]
        [ sh:class :StoryOutput ]
        [ sh:class :StoryDependent ]
    ) ;
    sh:not [
        sh:or (
            [ sh:class :Story ]
            [ sh:class concept:DataElementConcept ]
            [ sh:class concept:ConceptManifestation ]
        )
    ] ;
    sh:property [
        sh:path [
            sh:inversePath [
                sh:alternativePath ( :hasConceptUsage :hasInputConcept :hasOutputConcept :hasDependentConcept )
            ]
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class :Story ;
        sh:message "A concept usage must belong to exactly one story, counting general and specialized usage links together."@en
    ] ;
    sh:property [
        sh:path concept:hasConcept ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class concept:DataElementConcept ;
        sh:message "A concept usage must reference exactly one reusable data element concept through concept:hasConcept."@en
    ] ;
    rdfs:label "Story Concept Usage Shape"@en ;
    rdfs:comment "Validates one owning story, one referenced concept, and exactly one input, output, or dependent role. Usage objects are distinct from stories, concepts, and manifestations."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/story#> .

:StoryInputShape a sh:NodeShape ;
    sh:targetClass :StoryInput ;
    sh:targetObjectsOf :hasInputConcept ;
    sh:targetSubjectsOf :isMandatory , :isServerProvided ;
    sh:property [
        sh:path :isMandatory ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:defaultValue false ;
        sh:name "Is mandatory"@en
    ] ;
    sh:property [
        sh:path :isServerProvided ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:defaultValue false ;
        sh:name "Is server provided"@en
    ] ;
    rdfs:label "Story Input Shape"@en ;
    rdfs:comment "Validates optional, single-valued boolean input flags and records their false application defaults without materializing them."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/story#> .

:LegacyConceptUsageShape a sh:NodeShape ;
    sh:targetSubjectsOf :hasInput , :hasOutput , :serverProvidedIRI ;
    sh:targetClass :MandatoryParameter , :OptionalParameter , :OptionalStoryOutput ;
    sh:property [
        sh:path :hasInput ;
        sh:maxCount 0 ;
        sh:message "hasInput was removed. Use hasInputConcept to link to a StoryInput usage object."@en
    ] ;
    sh:property [
        sh:path :hasOutput ;
        sh:maxCount 0 ;
        sh:message "hasOutput was removed. Use hasOutputConcept to link to a StoryOutput usage object."@en
    ] ;
    sh:property [
        sh:path :serverProvidedIRI ;
        sh:maxCount 0 ;
        sh:message "serverProvidedIRI was removed. Identify the input usage and set isServerProvided on that usage."@en
    ] ;
    sh:not [
        sh:or (
            [ sh:class :MandatoryParameter ]
            [ sh:class :OptionalParameter ]
            [ sh:class :OptionalStoryOutput ]
        )
    ] ;
    rdfs:label "Legacy Concept Usage Shape"@en ;
    rdfs:comment "Rejects retired story input/output predicates, parameter classification classes, and the story-level server-provided flag. Data must migrate to typed concept usages and input flags."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/story#> .

:StoryImplementationShape a sh:NodeShape ;
    sh:targetClass :StoryImplementation ;
    sh:targetSubjectsOf :implementationOf , :implementationType ;
    sh:targetObjectsOf :implementedBy ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [
        sh:path [
            sh:alternativePath (
                :implementationOf
                [ sh:inversePath :implementedBy ]
            )
        ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:class :Story ;
        sh:message "A story implementation must belong to exactly one story, counting both implementationOf and inverse implementedBy links."@en
    ] ;
    rdfs:label "Story Implementation Shape"@en ;
    rdfs:comment "Validates exactly one owning story per implementation in the supplied version context. Counts both directions without requiring OWL inverse inference, including untyped relationship endpoints and implementation metadata."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/story#> .

:LegacyImplementationShape a sh:NodeShape ;
    sh:targetSubjectsOf :hasImplementation ;
    sh:property [
        sh:path :hasImplementation ;
        sh:maxCount 0 ;
        sh:message "hasImplementation was removed. Use implementedBy or its inverse implementationOf."@en
    ] ;
    rdfs:label "Legacy Implementation Shape"@en ;
    rdfs:comment "Rejects the retired hasImplementation predicate. Story implementation links use implementedBy and its inverse implementationOf."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/story#> .


