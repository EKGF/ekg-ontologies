@prefix : <https://ekgf.org/ontology/story#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obda: <https://w3id.org/obda/vocabulary#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix concept: <https://ekgf.org/ontology/concept#> .
@prefix outcome: <https://ekgf.org/ontology/outcome#> .
@prefix persona: <https://ekgf.org/ontology/persona#> .
@prefix story-svc: <https://ekgf.org/ontology/ekg-platform-story-service#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ekg-story: <https://ekgf.org/ontology/story#> .
@prefix ekg-shape: <https://ekgf.org/ontology/shape#> .
@prefix annotation: <https://ekgf.org/ontology/annotation#> .

<https://ekgf.org/ontology/story#> a owl:Ontology ;
  sh:declare [
      sh:prefix "ekg-story" ;
      sh:namespace "https://ekgf.org/ontology/story#"^^xsd:anyURI
  ] ;
	owl:imports <https://ekgf.org/ontology/persona#> , <https://ekgf.org/ontology/concept#> , <https://ekgf.org/ontology/outcome#> , ekg-shape: ;
	rdfs:comment "Stories, their extensible primary-purpose stereotypes, story-owned input, output, and dependent concept usages, execution requirements, and implementation ownership."@en ;
	rdfs:label "Story Ontology"@en .
