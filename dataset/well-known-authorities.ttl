@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix api: <https://ekgf.org/ontology/api#> .
@prefix artgov: <https://ekgf.org/ontology/artifact-governance#> .

#
# The well-known authorities.
#
# The IRI of an authority is a UUID derived from its host, the value of
# artgov:authorityHost: the name-based UUID (version 5) of the host in
# the DNS namespace. Two parties that describe the same host therefore
# mint the same IRI. To add an authority:
#
#   python3 -c "import uuid; print(uuid.uuid5(uuid.NAMESPACE_DNS, 'www.example.org'))"
#
# Every authority that governs an ontology, a shapeset or a taxonomy is
# declared here and nowhere else.
#

# ── W3C ──────────────────────────────────────────────────────

<urn:uuid:20f9ae73-f462-529f-ba7e-b5494fd68563>
    rdf:type artgov:Authority ;
    api:slug "w3c" ;
    rdfs:label "W3C"@en ;
    artgov:authorityAcronym "W3C" ;
    artgov:authorityHost "www.w3.org" ;
    artgov:baseIri "http://www.w3.org"^^xsd:anyURI ;
    artgov:autoLoad false .

