@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix api: <https://ekgf.org/ontology/api#> .
@prefix artgov: <https://ekgf.org/ontology/artifact-governance#> .
@prefix authority: <urn:legra:authority:> .

#
# The well-known authorities.
#
# The IRI of an authority is urn:legra:authority: followed by the
# lowercase hexadecimal SHA-256 of the string authority://<host>, where
# <host> is the value of artgov:authorityHost. To add an authority:
#
#   printf 'authority://%s' www.example.org | shasum -a 256
#
# Every authority that governs an ontology, a shapeset or a taxonomy is
# declared here and nowhere else.
#

# ── W3C ──────────────────────────────────────────────────────

authority:da00efad89faf7f3692e0ff1b94dc419fc43087ace62b9d238ad339fbfb12f95
