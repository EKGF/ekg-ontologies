###  Generated by the OWL API (version 4.5.9.2019-02-01T07:24:44Z) https://github.com/owlcs/owlapi

#################################################################
#    Capture metadata: formats, view order, git origin, formulas
#################################################################

:CsvFile
    a owl:Class ;
    rdfs:subClassOf :File ;
    rdfs:label "CSV file"@en ;
    rdfs:comment "A raw-data file source in comma-separated values format (RFC 4180). Every field is captured as text; the capture step does not infer datatypes."@en ;
    rdfs:isDefinedBy : .

:TsvFile
    a owl:Class ;
    rdfs:subClassOf :File ;
    rdfs:label "TSV file"@en ;
    rdfs:comment "A raw-data file source in tab-separated values format. Every field is captured as text; the capture step does not infer datatypes."@en ;
    rdfs:isDefinedBy : .

:ParquetFile
    a owl:Class ;
    rdfs:subClassOf :File ;
    rdfs:label "Parquet file"@en ;
    rdfs:comment "A raw-data file source in the Apache Parquet columnar format. One file is one view whose columns are the schema's top-level fields; values keep the literal datatypes that the file's physical and logical types define."@en ;
    rdfs:isDefinedBy : .

:viewNumber
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :View ;
    rdfs:range xsd:integer ;
    rdfs:label "View number"@en ;
    rdfs:comment "The 1-based position of a view within its source in the order the source exposes its views, such as the worksheet order of a workbook. A view name is not a stable substitute: names can repeat across sources and change between captures."@en ;
    rdfs:isDefinedBy : .

:gitRepository
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :File ;
    rdfs:range xsd:string ;
    rdfs:label "Git repository"@en ;
    rdfs:comment "The fetch URL of the default remote of the git repository whose work tree contained the file at capture time, recorded verbatim. Scp-style remotes such as git@host:org/repo.git are not IRIs, so the URL is a string."@en ;
    rdfs:isDefinedBy : .

:gitCommit
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :File ;
    rdfs:range xsd:string ;
    rdfs:label "Git commit"@en ;
    rdfs:comment "The object id, as lowercase hexadecimal, of the HEAD commit of the repository whose work tree contained the file at capture time. Together with gitPath it locates the file in history; gitModified states whether the captured bytes are the bytes of that commit."@en ;
    rdfs:isDefinedBy : .

:gitPath
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :File ;
    rdfs:range xsd:string ;
    rdfs:label "Git path"@en ;
    rdfs:comment "The path of the file relative to the root of the repository work tree, using '/' as separator, as git records it."@en ;
    rdfs:isDefinedBy : .

:gitBlob
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :File ;
    rdfs:range xsd:string ;
    rdfs:label "Git blob"@en ;
    rdfs:comment "The git blob object id, as lowercase hexadecimal, of the captured bytes. It is computed from the content alone, so it is present whether or not the file is in a repository, and equals the id git would assign to the same bytes."@en ;
    rdfs:isDefinedBy : .

:checksumByteCount
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "Checksum byte count"@en ;
    rdfs:comment "Limits a checksum (an spdx:Checksum) to the first N bytes of its file. A file cannot contain the checksum of its own final bytes, so a capture step that embeds a checksum in its output records it over the bytes that precede the checksum and states their number here. Without this property a checksum covers the whole file."@en ;
    rdfs:isDefinedBy : .

:gitModified
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :File ;
    rdfs:range xsd:boolean ;
    rdfs:label "Git modified"@en ;
    rdfs:comment "Whether the captured bytes differ from the file at gitPath in gitCommit. True also when the file is untracked in that commit. False means the capture is reproducible from the repository history."@en ;
    rdfs:isDefinedBy : .

:formula
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Value ;
    rdfs:range xsd:string ;
    rdfs:label "Formula"@en ;
    rdfs:comment "The spreadsheet formula that computes a captured value occurrence, verbatim in the source's A1 notation and without the leading '='. The value's literalValue is the result the source cached; an occurrence without a cached result is a NullValue that still records its formula."@en ;
    rdfs:isDefinedBy : .

:formulaR1C1
    a owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Value :Column ) ] ;
    rdfs:range xsd:string ;
    rdfs:label "Formula (R1C1)"@en ;
    rdfs:comment "A spreadsheet formula in R1C1 notation, with references relative to the cell holding it. On a Value it is that occurrence's formula. On a Column it is the single relative formula shared by every formula occurrence in the column, a derivation rule for the column that later steps can translate into SPARQL or SHACL rules."@en ;
    rdfs:isDefinedBy : .

#################################################################
#    Column profile
#################################################################

:nullCount
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Column ;
    rdfs:range xsd:integer ;
    rdfs:label "Null count"@en ;
    rdfs:comment "The number of captured value occurrences for this column that are NullValue."@en ;
    rdfs:isDefinedBy : .

:inferredDatatype
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Column ;
    rdfs:range rdfs:Datatype ;
    rdfs:label "Inferred datatype"@en ;
    rdfs:comment "A datatype to which conformingCount of the column's counted occurrences conform: their literalValue has this datatype, or its lexical form is valid for it. Which datatypes are considered and what share of conforming occurrences is required are capture policy; conformingCount records the evidence. Captured values keep their source literals."@en ;
    rdfs:isDefinedBy : .

:conformingCount
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Column ;
    rdfs:range xsd:integer ;
    rdfs:label "Conforming value count"@en ;
    rdfs:comment "The number of counted occurrences of this column conforming to its inferred datatype. Together with count it gives the share of the column that a later step can cast to that datatype, and identifies how many occurrences need attention."@en ;
    rdfs:isDefinedBy : .

#################################################################
