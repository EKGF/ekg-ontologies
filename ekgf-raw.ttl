    rdfs:isDefinedBy <https://ekgf.org/ontology/raw#> .

<https://ekgf.org/ontology/raw#freq>
    rdfs:comment "Records the occurrence count of the most frequently occurring value in a captured column."@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/raw#> .

