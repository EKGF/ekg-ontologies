    <http://purl.org/dc/elements/1.1/date> "2020-06-13T09:31:29Z"^^xsd:dateTime ;
    rdfs:comment "1-based column index"@en ;
    rdfs:label "Column number"@en .


###  https://ekgf.org/ontology/raw#count
:count
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Column ;
    rdfs:range xsd:integer ;
    rdfs:label "Value count"@en ;
    rdfs:comment "The number of captured value occurrences for this column (raw:forColumn) that are not NullValue. Header cells are not occurrences and are not counted."@en ;
    rdfs:isDefinedBy : .


