:S3Object
    a owl:Class ;
    rdfs:subClassOf :Source ;
    rdfs:label "S3 object"@en ;
    rdfs:comment "A source read from an object in Amazon S3 or an S3-compatible store. It is independent of the format classes: a CSV object is both a CsvFile and an S3Object. The s3 properties record the object as the store reported it at capture time."@en ;
    rdfs:isDefinedBy : .

:S3Entry
    a owl:Class ;
    rdfs:label "S3 entry"@en ;
    rdfs:comment "A key-value pair stored with an S3 object, as an object tag or as user-defined metadata."@en ;
    rdfs:isDefinedBy : .

:S3Tag
    a owl:Class ;
    rdfs:subClassOf :S3Entry ;
    rdfs:label "S3 tag"@en ;
    rdfs:comment "An object tag of an S3 object."@en ;
    rdfs:isDefinedBy : .

:S3UserMetadataEntry
