###  https://ekgf.org/ontology/raw#Value
:Value
    rdf:type owl:Class ;
    rdfs:subClassOf [
        a owl:Class ;
        owl:unionOf (
            :NullValue
            [ a owl:Restriction ; owl:onProperty :literalValue ; owl:minCardinality 1 ]
        )
    ] , [
        a owl:Restriction ; owl:onProperty :valueOf ; owl:minCardinality 1
    ] , [
        a owl:Restriction ; owl:onProperty :forColumn ; owl:minCardinality 1
    ] ;
    <http://purl.org/dc/elements/1.1/creator> <http://orcid.org/0000-0003-2309-5068> ;
