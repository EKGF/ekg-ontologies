###  https://ekgf.org/ontology/raw#predicate
:predicate
    rdf:type owl:AnnotationProperty ;
    rdfs:domain :Column ;
    rdfs:range rdf:Property ;
    <http://purl.org/dc/elements/1.1/date> "2020-06-13T09:33:37Z"^^xsd:dateTime ;
    rdfs:comment "The property that this Column is mapped to. A column is mapped to one property. It is an annotation property because its values are properties, which are not individuals."@en .


###  https://ekgf.org/ontology/raw#valueOf
:valueOf
    rdf:type owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Value ;
    rdfs:range :Row ;
    <http://purl.org/dc/elements/1.1/date> "2020-06-13T09:17:59Z"^^xsd:dateTime ;
    rdfs:comment "Identifies the one source row at which a value occurrence was captured. The row and the occurrence's forColumn must belong to the same view."@en ;
