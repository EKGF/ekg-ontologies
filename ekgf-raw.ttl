    rdfs:isDefinedBy <https://ekgf.org/ontology/raw#> .


<https://ekgf.org/ontology/raw#hasView>
    rdfs:label "Has View"@en ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/raw#> .

<https://ekgf.org/ontology/raw#isRowInView>
    rdfs:label "Is Row In View"@en ;
