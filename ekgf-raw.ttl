    rdfs:isDefinedBy <https://ekgf.org/ontology/raw#> .


:NullValue
    a owl:Class ;
    rdfs:subClassOf :Value , [
        a owl:Restriction ; owl:onProperty :literalValue ; owl:maxCardinality 0
    ] ;
    rdfs:label "Null value"@en ;
    rdfs:comment "A captured value occurrence whose source explicitly reports null. It has no literalValue. Missing content metadata and empty strings do not imply this classification; the source reader must identify the null according to the source format or an explicit capture policy."@en ;
    rdfs:isDefinedBy : .

