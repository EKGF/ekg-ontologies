###  https://ekgf.org/ontology/raw#localName
:localName
    rdf:type owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain :Column ;
    rdfs:range xsd:string ;
    <http://purl.org/dc/elements/1.1/date> "2020-06-13T09:32:26Z"^^xsd:dateTime ;
    rdfs:comment "The local name of the property that this Column is mapped to"@en ;
    rdfs:label "Local name"@en .


###  https://ekgf.org/ontology/raw#max
:max
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Column ;
    rdfs:range rdfs:Literal ;
    rdfs:label "Maximum"@en ;
    rdfs:comment "The greatest value, in the value space of the inferred datatype, among occurrences conforming to it, written as a literal of that datatype."@en ;
    rdfs:isDefinedBy : .


###  https://ekgf.org/ontology/raw#mean
:mean
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Column ;
    rdfs:range xsd:double ;
    rdfs:label "Mean"@en ;
    rdfs:comment "The arithmetic mean of the numeric values of occurrences conforming to a numeric inferred datatype."@en ;
    rdfs:isDefinedBy : .


###  https://ekgf.org/ontology/raw#min
:min
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Column ;
    rdfs:range rdfs:Literal ;
    rdfs:label "Minimum"@en ;
    rdfs:comment "The least value, in the value space of the inferred datatype, among occurrences conforming to it, written as a literal of that datatype."@en ;
    rdfs:isDefinedBy : .


###  https://ekgf.org/ontology/raw#std
:std
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Column ;
    rdfs:range xsd:double ;
    rdfs:label "Standard deviation"@en ;
    rdfs:comment "The sample standard deviation (divisor n - 1) of the numeric values of occurrences conforming to a numeric inferred datatype."@en ;
    rdfs:isDefinedBy : .


###  https://ekgf.org/ontology/raw#top
:top
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Column ;
    rdfs:range rdfs:Literal ;
    rdfs:label "Most frequent value"@en ;
    rdfs:comment "A literalValue occurring most often among the counted occurrences. When several occur equally often, the one whose N-Triples form sorts first by code point."@en ;
    rdfs:isDefinedBy : .


###  https://ekgf.org/ontology/raw#unique
:unique
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Column ;
    rdfs:range xsd:integer ;
    rdfs:label "Distinct value count"@en ;
    rdfs:comment "The number of distinct RDF terms among the literalValue of the counted occurrences; literals with different datatypes or language tags are distinct. Absence means the measure was not computed, not that there are no values."@en ;
    rdfs:isDefinedBy : .


###  https://ekgf.org/ontology/raw#viewRowNumber
:viewRowNumber
    rdf:type owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain :Row ;
    rdfs:range xsd:integer ;
    <http://purl.org/dc/elements/1.1/date> "2020-06-13T09:41:42Z"^^xsd:dateTime ;
    rdfs:comment "The 0-based sequence number of the Row in the given View as it was encountered in the Source"@en .


###  https://ekgf.org/ontology/raw#25pct
:25pct
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Column ;
    rdfs:range xsd:double ;
    rdfs:label "25th percentile"@en ;
    rdfs:comment "The 25th percentile of the numeric values of occurrences conforming to a numeric inferred datatype, interpolating linearly between the closest ranks (Hyndman and Fan type 7)."@en ;
    rdfs:isDefinedBy : .


###  https://ekgf.org/ontology/raw#50pct
:50pct
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Column ;
    rdfs:range xsd:double ;
    rdfs:label "Median"@en ;
    rdfs:comment "The 50th percentile (median) of the numeric values of occurrences conforming to a numeric inferred datatype, interpolating linearly between the closest ranks (Hyndman and Fan type 7)."@en ;
    rdfs:isDefinedBy : .


###  https://ekgf.org/ontology/raw#75pct
:75pct
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Column ;
    rdfs:range xsd:double ;
    rdfs:label "75th percentile"@en ;
    rdfs:comment "The 75th percentile of the numeric values of occurrences conforming to a numeric inferred datatype, interpolating linearly between the closest ranks (Hyndman and Fan type 7)."@en ;
    rdfs:isDefinedBy : .


