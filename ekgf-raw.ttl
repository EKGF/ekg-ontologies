    rdfs:label "S3 endpoint"@en ;
    rdfs:comment "The endpoint URL of an S3-compatible store other than Amazon S3. Absent for Amazon S3 itself."@en ;
    rdfs:isDefinedBy : .

:s3VersionId
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :S3Object ;
    rdfs:range xsd:string ;
    rdfs:label "S3 version id"@en ;
    rdfs:comment "The version id of the captured object version, when the bucket is versioned."@en ;
    rdfs:isDefinedBy : .

:s3ETag
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :S3Object ;
    rdfs:range xsd:string ;
    rdfs:label "S3 ETag"@en ;
    rdfs:comment "The entity tag S3 reports for the object, without its surrounding quotes. For single-part uploads without SSE-KMS it is the MD5 of the content; for multipart uploads it ends in -N, the part count. It identifies the object version, not the content."@en ;
    rdfs:isDefinedBy : .

:s3ContentType
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :S3Object ;
    rdfs:range xsd:string ;
    rdfs:label "S3 content type"@en ;
    rdfs:comment "The Content-Type stored with the object, verbatim. It may differ from the media type the capture step determined."@en ;
    rdfs:isDefinedBy : .

:s3ContentEncoding
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :S3Object ;
    rdfs:range xsd:string ;
    rdfs:label "S3 content encoding"@en ;
    rdfs:comment "The Content-Encoding stored with the object, verbatim."@en ;
    rdfs:isDefinedBy : .

:s3ContentLanguage
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :S3Object ;
    rdfs:range xsd:string ;
    rdfs:label "S3 content language"@en ;
    rdfs:comment "The Content-Language stored with the object, verbatim."@en ;
    rdfs:isDefinedBy : .

:s3ContentDisposition
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :S3Object ;
    rdfs:range xsd:string ;
    rdfs:label "S3 content disposition"@en ;
    rdfs:comment "The Content-Disposition stored with the object, verbatim."@en ;
    rdfs:isDefinedBy : .

:s3CacheControl
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :S3Object ;
    rdfs:range xsd:string ;
    rdfs:label "S3 cache control"@en ;
    rdfs:comment "The Cache-Control stored with the object, verbatim."@en ;
    rdfs:isDefinedBy : .

:s3StorageClass
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :S3Object ;
    rdfs:range xsd:string ;
    rdfs:label "S3 storage class"@en ;
    rdfs:comment "The storage class of the object, such as STANDARD or GLACIER_IR."@en ;
    rdfs:isDefinedBy : .

:s3ServerSideEncryption
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :S3Object ;
    rdfs:range xsd:string ;
    rdfs:label "S3 server-side encryption"@en ;
    rdfs:comment "The server-side encryption algorithm S3 reports, such as AES256 or aws:kms."@en ;
    rdfs:isDefinedBy : .

:s3KmsKeyId
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :S3Object ;
    rdfs:range xsd:string ;
    rdfs:label "S3 KMS key id"@en ;
    rdfs:comment "The identifier of the KMS key that encrypts the object, when SSE-KMS is used."@en ;
    rdfs:isDefinedBy : .

:s3BucketKeyEnabled
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :S3Object ;
    rdfs:range xsd:boolean ;
    rdfs:label "S3 bucket key enabled"@en ;
    rdfs:comment "Whether the object uses an S3 Bucket Key for SSE-KMS."@en ;
    rdfs:isDefinedBy : .

:s3ChecksumType
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :S3Object ;
    rdfs:range xsd:string ;
    rdfs:label "S3 checksum type"@en ;
    rdfs:comment "The type of the object's additional checksums: FULL_OBJECT, a checksum of the whole content, or COMPOSITE, a checksum of the part checksums of a multipart upload."@en ;
    rdfs:isDefinedBy : .

:s3ChecksumCrc32
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :S3Object ;
    rdfs:range xsd:string ;
    rdfs:label "S3 CRC32 checksum"@en ;
    rdfs:comment "The CRC32 checksum S3 stores for the object, base64-encoded as S3 returns it."@en ;
    rdfs:isDefinedBy : .

:s3ChecksumCrc32c
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :S3Object ;
    rdfs:range xsd:string ;
    rdfs:label "S3 CRC32C checksum"@en ;
    rdfs:comment "The CRC32C checksum S3 stores for the object, base64-encoded as S3 returns it."@en ;
    rdfs:isDefinedBy : .

:s3ChecksumCrc64Nvme
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :S3Object ;
    rdfs:range xsd:string ;
    rdfs:label "S3 CRC64NVME checksum"@en ;
    rdfs:comment "The CRC64NVME checksum S3 stores for the object, base64-encoded as S3 returns it."@en ;
    rdfs:isDefinedBy : .

:s3ChecksumSha1
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :S3Object ;
    rdfs:range xsd:string ;
    rdfs:label "S3 SHA-1 checksum"@en ;
    rdfs:comment "The SHA-1 checksum S3 stores for the object, base64-encoded as S3 returns it."@en ;
    rdfs:isDefinedBy : .

:s3ChecksumSha256
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :S3Object ;
    rdfs:range xsd:string ;
    rdfs:label "S3 SHA-256 checksum"@en ;
    rdfs:comment "The SHA-256 checksum S3 stores for the object, base64-encoded as S3 returns it. With s3ChecksumType FULL_OBJECT it is the SHA-256 of the content."@en ;
    rdfs:isDefinedBy : .

:s3PartsCount
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :S3Object ;
    rdfs:range xsd:integer ;
    rdfs:label "S3 parts count"@en ;
    rdfs:comment "The number of parts of a multipart-uploaded object."@en ;
    rdfs:isDefinedBy : .

:s3ObjectLockMode
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :S3Object ;
    rdfs:range xsd:string ;
    rdfs:label "S3 Object Lock mode"@en ;
    rdfs:comment "The Object Lock retention mode of the object version: GOVERNANCE or COMPLIANCE."@en ;
    rdfs:isDefinedBy : .

:s3ObjectLockRetainUntil
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :S3Object ;
    rdfs:range xsd:dateTime ;
    rdfs:label "S3 Object Lock retain until"@en ;
    rdfs:comment "The date and time until which the object version is retained under Object Lock."@en ;
    rdfs:isDefinedBy : .

:s3ObjectLockLegalHold
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :S3Object ;
    rdfs:range xsd:boolean ;
    rdfs:label "S3 Object Lock legal hold"@en ;
    rdfs:comment "Whether a legal hold is placed on the object version."@en ;
    rdfs:isDefinedBy : .

:s3ReplicationStatus
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :S3Object ;
    rdfs:range xsd:string ;
    rdfs:label "S3 replication status"@en ;
    rdfs:comment "The replication status S3 reports for the object, such as COMPLETED or REPLICA."@en ;
    rdfs:isDefinedBy : .

:s3Expiration
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :S3Object ;
    rdfs:range xsd:string ;
    rdfs:label "S3 expiration"@en ;
    rdfs:comment "The expiration S3 reports from a lifecycle rule, verbatim as the x-amz-expiration header."@en ;
    rdfs:isDefinedBy : .

:s3Tag
    a owl:ObjectProperty ;
    rdfs:domain :S3Object ;
    rdfs:range :S3Tag ;
    rdfs:label "S3 tag"@en ;
    rdfs:comment "Links an S3 object to one of its object tags."@en ;
    rdfs:isDefinedBy : .

:s3UserMetadata
    a owl:ObjectProperty ;
    rdfs:domain :S3Object ;
    rdfs:range :S3UserMetadataEntry ;
    rdfs:label "S3 user metadata"@en ;
    rdfs:comment "Links an S3 object to one of its user-defined metadata entries."@en ;
    rdfs:isDefinedBy : .

:s3EntryKey
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :S3Entry ;
    rdfs:range xsd:string ;
    rdfs:label "S3 entry key"@en ;
    rdfs:comment "The key of an S3 tag or user metadata entry, verbatim."@en ;
    rdfs:isDefinedBy : .

:s3EntryValue
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :S3Entry ;
    rdfs:range xsd:string ;
    rdfs:label "S3 entry value"@en ;
    rdfs:comment "The value of an S3 tag or user metadata entry, verbatim. An empty value is a value."@en ;
    rdfs:isDefinedBy : .

#################################################################
#    Raw data validation
#################################################################

:ValueContentShape a sh:NodeShape ;
    sh:targetClass :Value ;
    sh:targetSubjectsOf :literalValue , :sourceText , :valueOf , :forPredicate , :forColumn ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:xone (
        [
            sh:class :NullValue ;
            sh:property [ sh:path :literalValue ; sh:maxCount 0 ]
        ]
        [
            sh:not [ sh:class :NullValue ] ;
            sh:property [
                sh:path :literalValue ;
                sh:minCount 1 ; sh:maxCount 1 ;
                sh:nodeKind sh:Literal
            ]
        ]
    ) ;
    sh:property [
        sh:path :sourceText ; sh:maxCount 1 ; sh:datatype xsd:string
    ] ;
    sh:message "A captured value must have exactly one literalValue or be explicitly typed NullValue without a literalValue. Source text alone does not supply the content."@en ;
    rdfs:label "Value Content Shape"@en ;
    rdfs:comment "Validates the content of raw value occurrences, including subclasses and untyped resources using capture properties. Accepts typed and language-tagged literals and empty strings, distinguishes explicit source nulls, and checks optional original source text. Location constraints are enforced separately by ValueLocationShape, RowLocationShape, and ColumnLocationShape."@en ;
    rdfs:isDefinedBy : .

:ValueLocationShape a sh:NodeShape ;
    sh:targetClass :Value ;
    sh:targetSubjectsOf :literalValue , :sourceText , :valueOf , :forPredicate , :forColumn ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [
        sh:path :valueOf ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ; sh:class :Row ;
        sh:message "A captured value must identify exactly one source row through valueOf."@en
    ] ;
    sh:property [
        sh:path :forColumn ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ; sh:class :Column ;
        sh:message "A captured value must identify exactly one physical source column through forColumn."@en
    ] ;
    sh:sparql [
        sh:message "A captured value's row and column must belong to the same view."@en ;
        sh:select """
            SELECT $this WHERE {
                $this <https://ekgf.org/ontology/raw#valueOf>/<https://ekgf.org/ontology/raw#isRowInView> ?rowView .
                $this <https://ekgf.org/ontology/raw#forColumn>/(<https://ekgf.org/ontology/raw#isColumnInView>|^<https://ekgf.org/ontology/raw#hasColumn>) ?columnView .
                FILTER (?rowView != ?columnView)
            }
        """
    ] ;
    rdfs:label "Value Location Shape"@en ;
    rdfs:comment "Requires one resource row and one resource column for each captured value, including nulls, and rejects row/column view mismatches. Predicate mappings cannot substitute for physical column links."@en ;
    rdfs:isDefinedBy : .

:RowLocationShape a sh:NodeShape ;
    sh:targetClass :Row ;
    sh:targetObjectsOf :valueOf ;
    sh:targetSubjectsOf :isRowInView ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [
        sh:path :isRowInView ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ; sh:class :View ;
        sh:message "A source row must belong to exactly one view through isRowInView."@en
    ] ;
    rdfs:label "Row Location Shape"@en ;
    rdfs:comment "Requires each supplied source row to identify one resource view, including subclasses and untyped row-link endpoints. Coordinate bounds and view-to-source ownership are separate constraints."@en ;
    rdfs:isDefinedBy : .

:ColumnLocationShape a sh:NodeShape ;
    sh:targetClass :Column ;
    sh:targetObjectsOf :forColumn , :hasColumn ;
    sh:targetSubjectsOf :isColumnInView ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [
        sh:path [ sh:alternativePath ( :isColumnInView [ sh:inversePath :hasColumn ] ) ] ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ; sh:class :View ;
        sh:message "A physical source column must belong to exactly one view, counting isColumnInView and inverse hasColumn together."@en
    ] ;
    rdfs:label "Column Location Shape"@en ;
    rdfs:comment "Requires each physical source column to belong to one resource view. Counts both membership directions without requiring OWL inverse inference, and covers subclasses and untyped link endpoints."@en ;
    rdfs:isDefinedBy : .

:ViewNumberShape a sh:NodeShape ;
    sh:targetSubjectsOf :viewNumber ;
    sh:property [
        sh:path :viewNumber ; sh:maxCount 1 ;
        sh:datatype xsd:integer ; sh:minInclusive 1 ;
        sh:message "A view has at most one viewNumber, a positive xsd:integer."@en
    ] ;
    rdfs:label "View Number Shape"@en ;
    rdfs:comment "Validates the 1-based position of a view within its source."@en ;
    rdfs:isDefinedBy : .

:ChecksumByteCountShape a sh:NodeShape ;
    sh:targetSubjectsOf :checksumByteCount ;
    sh:property [
        sh:path :checksumByteCount ; sh:maxCount 1 ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:message "A checksum covers one byte count, an xsd:nonNegativeInteger."@en
    ] , [
        sh:path <http://spdx.org/rdf/terms#checksumValue> ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A checksum with a byte count has exactly one spdx:checksumValue."@en
    ] , [
        sh:path <http://spdx.org/rdf/terms#algorithm> ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A checksum with a byte count has exactly one spdx:algorithm."@en
    ] ;
    rdfs:label "Checksum Byte Count Shape"@en ;
    rdfs:comment "Validates a checksum limited to the leading bytes of its file: one byte count, with the value and algorithm needed to verify it."@en ;
    rdfs:isDefinedBy : .

:GitOriginShape a sh:NodeShape ;
    sh:targetSubjectsOf :gitRepository , :gitCommit , :gitPath , :gitBlob , :gitModified ;
    sh:property [
        sh:path :gitRepository ; sh:maxCount 1 ; sh:datatype xsd:string
    ] , [
        sh:path :gitCommit ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:pattern "^([0-9a-f]{40}|[0-9a-f]{64})$" ;
        sh:message "gitCommit is one lowercase hexadecimal SHA-1 or SHA-256 object id."@en
    ] , [
        sh:path :gitBlob ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:pattern "^([0-9a-f]{40}|[0-9a-f]{64})$" ;
        sh:message "gitBlob is one lowercase hexadecimal SHA-1 or SHA-256 object id."@en
    ] , [
        sh:path :gitPath ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:pattern "^[^/\\\\][^\\\\]*$" ;
        sh:message "gitPath is one work-tree-relative path using '/' separators."@en
    ] , [
        sh:path :gitModified ; sh:maxCount 1 ; sh:datatype xsd:boolean
    ] ;
    sh:or (
        [ sh:property [ sh:path :gitCommit ; sh:maxCount 0 ] ;
          sh:property [ sh:path :gitPath ; sh:maxCount 0 ] ;
          sh:property [ sh:path :gitModified ; sh:maxCount 0 ] ;
          sh:property [ sh:path :gitRepository ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path :gitCommit ; sh:minCount 1 ] ;
          sh:property [ sh:path :gitPath ; sh:minCount 1 ] ;
          sh:property [ sh:path :gitModified ; sh:minCount 1 ] ]
    ) ;
    sh:message "A file in a repository records gitCommit, gitPath and gitModified together; gitRepository requires them. gitBlob alone is valid outside a repository."@en ;
    rdfs:label "Git Origin Shape"@en ;
    rdfs:comment "Validates the git provenance of a captured file: object id syntax, a relative path, and that a commit is always accompanied by the path and modification state needed to reproduce the capture."@en ;
    rdfs:isDefinedBy : .

:FormulaShape a sh:NodeShape ;
    sh:targetSubjectsOf :formula ;
    sh:class :Value ;
    sh:property [
        sh:path :formula ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:pattern "^[^=]" ;
        sh:message "A value has at most one formula: a non-empty string in A1 notation without the leading '='."@en
    ] ;
    rdfs:label "Formula Shape"@en ;
    rdfs:comment "Validates verbatim spreadsheet formulas on captured value occurrences."@en ;
    rdfs:isDefinedBy : .

:FormulaR1C1Shape a sh:NodeShape ;
    sh:targetSubjectsOf :formulaR1C1 ;
    sh:or ( [ sh:class :Value ] [ sh:class :Column ] ) ;
    sh:property [
        sh:path :formulaR1C1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "A value or column has at most one relative R1C1 formula, a string."@en
    ] ;
    sh:message "formulaR1C1 belongs to a captured value occurrence or to a column whose formulas share one relative form."@en ;
    rdfs:label "Formula R1C1 Shape"@en ;
    rdfs:comment "Validates relative R1C1 formulas on value occurrences and the single shared derivation rule of a column."@en ;
    rdfs:isDefinedBy : .

:ColumnProfileShape a sh:NodeShape ;
    sh:targetSubjectsOf :count , :nullCount , :unique , :top , :freq ,
        :inferredDatatype , :conformingCount , :min , :max , :mean , :std ,
        :25pct , :50pct , :75pct ;
    sh:class :Column ;
    sh:property [ sh:path :count ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
    sh:property [ sh:path :nullCount ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
    sh:property [ sh:path :unique ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
    sh:property [ sh:path :freq ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
    sh:property [ sh:path :conformingCount ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
    sh:property [ sh:path :mean ; sh:maxCount 1 ; sh:datatype xsd:double ] ;
    sh:property [ sh:path :std ; sh:maxCount 1 ; sh:datatype xsd:double ] ;
    sh:property [ sh:path :25pct ; sh:maxCount 1 ; sh:datatype xsd:double ] ;
    sh:property [ sh:path :50pct ; sh:maxCount 1 ; sh:datatype xsd:double ] ;
    sh:property [ sh:path :75pct ; sh:maxCount 1 ; sh:datatype xsd:double ] ;
    sh:property [ sh:path :top ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ;
    sh:property [ sh:path :min ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ;
    sh:property [ sh:path :max ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ;
    sh:property [ sh:path :inferredDatatype ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:sparql [
        sh:message "unique, freq and conformingCount cannot exceed count."@en ;
        sh:select """
            SELECT $this WHERE {
                $this <https://ekgf.org/ontology/raw#count> ?count .
                $this <https://ekgf.org/ontology/raw#unique>|<https://ekgf.org/ontology/raw#freq>|<https://ekgf.org/ontology/raw#conformingCount> ?part .
                FILTER (?part > ?count)
            }
        """
    ] , [
        sh:message "inferredDatatype and conformingCount are stated together."@en ;
        sh:select """
            SELECT $this WHERE {
                { $this <https://ekgf.org/ontology/raw#inferredDatatype> ?t FILTER NOT EXISTS { $this <https://ekgf.org/ontology/raw#conformingCount> ?c } }
                UNION
                { $this <https://ekgf.org/ontology/raw#conformingCount> ?c FILTER NOT EXISTS { $this <https://ekgf.org/ontology/raw#inferredDatatype> ?t } }
            }
        """
    ] , [
        sh:message "top and freq are stated together."@en ;
        sh:select """
            SELECT $this WHERE {
                { $this <https://ekgf.org/ontology/raw#top> ?t FILTER NOT EXISTS { $this <https://ekgf.org/ontology/raw#freq> ?f } }
                UNION
                { $this <https://ekgf.org/ontology/raw#freq> ?f FILTER NOT EXISTS { $this <https://ekgf.org/ontology/raw#top> ?t } }
            }
        """
    ] , [
        sh:message "min, max, mean, std and percentiles describe conforming values and require an inferredDatatype."@en ;
        sh:select """
            SELECT $this WHERE {
                $this <https://ekgf.org/ontology/raw#min>|<https://ekgf.org/ontology/raw#max>|<https://ekgf.org/ontology/raw#mean>|<https://ekgf.org/ontology/raw#std>|<https://ekgf.org/ontology/raw#25pct>|<https://ekgf.org/ontology/raw#50pct>|<https://ekgf.org/ontology/raw#75pct> ?stat .
                FILTER NOT EXISTS { $this <https://ekgf.org/ontology/raw#inferredDatatype> ?t }
            }
        """
    ] , [
        sh:message "min, 25pct, 50pct, 75pct and max must be in non-decreasing order."@en ;
        sh:select """
            SELECT $this WHERE {
                { $this <https://ekgf.org/ontology/raw#min> ?a ; <https://ekgf.org/ontology/raw#25pct> ?b }
                UNION
                { $this <https://ekgf.org/ontology/raw#25pct> ?a ; <https://ekgf.org/ontology/raw#50pct> ?b }
                UNION
                { $this <https://ekgf.org/ontology/raw#50pct> ?a ; <https://ekgf.org/ontology/raw#75pct> ?b }
                UNION
                { $this <https://ekgf.org/ontology/raw#75pct> ?a ; <https://ekgf.org/ontology/raw#max> ?b }
                UNION
                { $this <https://ekgf.org/ontology/raw#min> ?a ; <https://ekgf.org/ontology/raw#max> ?b }
                FILTER (?b < ?a)
            }
        """
    ] ;
    rdfs:label "Column Profile Shape"@en ;
    rdfs:comment "Validates a column profile: single-valued measures with precise datatypes, counts bounded by the value count, an inferred datatype together with its evidence, statistics only with an inferred datatype, and ordered extremes and percentiles."@en ;
    rdfs:isDefinedBy : .

:S3ObjectShape a sh:NodeShape ;
    sh:targetClass :S3Object ;
    sh:property [ sh:path :s3Bucket ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; ] ;
    sh:property [ sh:path :s3Key ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; ] ;
    sh:property [ sh:path :s3Region ; sh:maxCount 1 ; sh:datatype xsd:string ; ] ;
    sh:property [ sh:path :s3Endpoint ; sh:maxCount 1 ; sh:datatype xsd:string ; ] ;
    sh:property [ sh:path :s3VersionId ; sh:maxCount 1 ; sh:datatype xsd:string ; ] ;
    sh:property [ sh:path :s3ETag ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[^\"]+$" ; ] ;
    sh:property [ sh:path :s3ContentType ; sh:maxCount 1 ; sh:datatype xsd:string ; ] ;
    sh:property [ sh:path :s3ContentEncoding ; sh:maxCount 1 ; sh:datatype xsd:string ; ] ;
    sh:property [ sh:path :s3ContentLanguage ; sh:maxCount 1 ; sh:datatype xsd:string ; ] ;
    sh:property [ sh:path :s3ContentDisposition ; sh:maxCount 1 ; sh:datatype xsd:string ; ] ;
    sh:property [ sh:path :s3CacheControl ; sh:maxCount 1 ; sh:datatype xsd:string ; ] ;
    sh:property [ sh:path :s3StorageClass ; sh:maxCount 1 ; sh:datatype xsd:string ; ] ;
    sh:property [ sh:path :s3ServerSideEncryption ; sh:maxCount 1 ; sh:datatype xsd:string ; ] ;
    sh:property [ sh:path :s3KmsKeyId ; sh:maxCount 1 ; sh:datatype xsd:string ; ] ;
    sh:property [ sh:path :s3BucketKeyEnabled ; sh:maxCount 1 ; sh:datatype xsd:boolean ; ] ;
    sh:property [ sh:path :s3ChecksumType ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:in ( "FULL_OBJECT" "COMPOSITE" ) ; ] ;
    sh:property [ sh:path :s3ChecksumCrc32 ; sh:maxCount 1 ; sh:datatype xsd:string ; ] ;
    sh:property [ sh:path :s3ChecksumCrc32c ; sh:maxCount 1 ; sh:datatype xsd:string ; ] ;
    sh:property [ sh:path :s3ChecksumCrc64Nvme ; sh:maxCount 1 ; sh:datatype xsd:string ; ] ;
    sh:property [ sh:path :s3ChecksumSha1 ; sh:maxCount 1 ; sh:datatype xsd:string ; ] ;
    sh:property [ sh:path :s3ChecksumSha256 ; sh:maxCount 1 ; sh:datatype xsd:string ; ] ;
    sh:property [ sh:path :s3PartsCount ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ; ] ;
    sh:property [ sh:path :s3ObjectLockMode ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:in ( "GOVERNANCE" "COMPLIANCE" ) ; ] ;
    sh:property [ sh:path :s3ObjectLockRetainUntil ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; ] ;
    sh:property [ sh:path :s3ObjectLockLegalHold ; sh:maxCount 1 ; sh:datatype xsd:boolean ; ] ;
    sh:property [ sh:path :s3ReplicationStatus ; sh:maxCount 1 ; sh:datatype xsd:string ; ] ;
    sh:property [ sh:path :s3Expiration ; sh:maxCount 1 ; sh:datatype xsd:string ; ] ;
    sh:property [ sh:path :s3Tag ; sh:class :S3Tag ; sh:nodeKind sh:BlankNodeOrIRI ] ;
    sh:property [ sh:path :s3UserMetadata ; sh:class :S3UserMetadataEntry ; sh:nodeKind sh:BlankNodeOrIRI ] ;
    rdfs:label "S3 Object Shape"@en ;
    rdfs:comment "Validates an S3 object source: exactly one bucket and key, single-valued typed metadata, an ETag without quotes, enumerated checksum types and Object Lock modes, and tags and user metadata as entries."@en ;
    rdfs:isDefinedBy : .

:S3EntryShape a sh:NodeShape ;
    sh:targetClass :S3Entry ;
    sh:targetObjectsOf :s3Tag , :s3UserMetadata ;
    sh:property [ sh:path :s3EntryKey ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path :s3EntryValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    rdfs:label "S3 Entry Shape"@en ;
    rdfs:comment "Validates an S3 tag or user metadata entry: exactly one key and one value, both strings."@en ;
    rdfs:isDefinedBy : .

<https://ekgf.org/ontology/raw#> a sh:ShapesGraph .

