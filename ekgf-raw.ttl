###  https://ekgf.org/ontology/raw#Column
:Column
    rdf:type owl:Class ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty :isColumnInView ; owl:minCardinality 1
    ] ;
    <http://purl.org/dc/elements/1.1/date> "2020-06-13T09:09:19Z"^^xsd:dateTime ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/raw#> .


###  https://ekgf.org/ontology/raw#File
:File
    rdf:type owl:Class ;
    rdfs:subClassOf :Source ;
    <http://purl.org/dc/elements/1.1/date> "2020-06-13T09:26:36Z"^^xsd:dateTime ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/raw#> .


###  https://ekgf.org/ontology/raw#Row
:Row
    rdf:type owl:Class ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty :isRowInView ; owl:minCardinality 1
    ] ;
    <http://purl.org/dc/elements/1.1/date> "2020-06-13T09:09:08Z"^^xsd:dateTime ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/raw#> .


###  https://ekgf.org/ontology/raw#Source
:Source
    rdf:type owl:Class ;
    <http://purl.org/dc/elements/1.1/date> "2020-06-13T09:26:09Z"^^xsd:dateTime ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/raw#> .


###  https://ekgf.org/ontology/raw#Value
:Value
    rdf:type owl:Class ;
    rdfs:subClassOf [
        a owl:Class ;
        owl:unionOf (
            :NullValue
            [ a owl:Restriction ; owl:onProperty :literalValue ; owl:minCardinality 1 ]
        )
    ] , [
        a owl:Restriction ; owl:onProperty :valueOf ; owl:minCardinality 1
    ] , [
        a owl:Restriction ; owl:onProperty :forColumn ; owl:minCardinality 1
    ] ;
    <http://purl.org/dc/elements/1.1/date> "2020-06-13T09:14:07Z"^^xsd:dateTime ;
    rdfs:isDefinedBy <https://ekgf.org/ontology/raw#> .


:NullValue
    a owl:Class ;
    rdfs:subClassOf :Value , [
        a owl:Restriction ; owl:onProperty :literalValue ; owl:maxCardinality 0
    ] ;
    rdfs:label "Null value"@en ;
    rdfs:comment "A captured value occurrence whose source explicitly reports null. It has no literalValue. Missing content metadata and empty strings do not imply this classification; the source reader must identify the null according to the source format or an explicit capture policy."@en ;
    rdfs:isDefinedBy : .

###  https://ekgf.org/ontology/raw#View
:View
