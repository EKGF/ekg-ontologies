:ValueContentShape a sh:NodeShape ;
    sh:targetClass :Value ;
    sh:targetSubjectsOf :literalValue , :sourceText , :valueOf , :forPredicate , :forColumn ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:xone (
        [
            sh:class :NullValue ;
            sh:property [ sh:path :literalValue ; sh:maxCount 0 ]
        ]
        [
            sh:not [ sh:class :NullValue ] ;
            sh:property [
                sh:path :literalValue ;
                sh:minCount 1 ; sh:maxCount 1 ;
                sh:nodeKind sh:Literal
            ]
        ]
    ) ;
    sh:property [
        sh:path :sourceText ; sh:maxCount 1 ; sh:datatype xsd:string
    ] ;
    sh:message "A captured value must have exactly one literalValue or be explicitly typed NullValue without a literalValue. Source text alone does not supply the content."@en ;
    rdfs:label "Value Content Shape"@en ;
    rdfs:comment "Validates the content of raw value occurrences, including subclasses and untyped resources using capture properties. Accepts typed and language-tagged literals and empty strings, distinguishes explicit source nulls, and checks optional original source text. Location constraints are enforced separately by ValueLocationShape, RowLocationShape, and ColumnLocationShape."@en ;
    rdfs:isDefinedBy : .

:ValueLocationShape a sh:NodeShape ;
    sh:targetClass :Value ;
    sh:targetSubjectsOf :literalValue , :sourceText , :valueOf , :forPredicate , :forColumn ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [
        sh:path :valueOf ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ; sh:class :Row ;
        sh:message "A captured value must identify exactly one source row through valueOf."@en
    ] ;
    sh:property [
        sh:path :forColumn ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ; sh:class :Column ;
        sh:message "A captured value must identify exactly one physical source column through forColumn."@en
    ] ;
    sh:sparql [
        sh:message "A captured value's row and column must belong to the same view."@en ;
        sh:select """
            SELECT $this WHERE {
                $this <https://ekgf.org/ontology/raw#valueOf>/<https://ekgf.org/ontology/raw#isRowInView> ?rowView .
                $this <https://ekgf.org/ontology/raw#forColumn>/(<https://ekgf.org/ontology/raw#isColumnInView>|^<https://ekgf.org/ontology/raw#hasColumn>) ?columnView .
                FILTER (?rowView != ?columnView)
            }
        """
    ] ;
    rdfs:label "Value Location Shape"@en ;
    rdfs:comment "Requires one resource row and one resource column for each captured value, including nulls, and rejects row/column view mismatches. Predicate mappings cannot substitute for physical column links."@en ;
    rdfs:isDefinedBy : .

:RowLocationShape a sh:NodeShape ;
    sh:targetClass :Row ;
    sh:targetObjectsOf :valueOf ;
    sh:targetSubjectsOf :isRowInView ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [
        sh:path :isRowInView ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ; sh:class :View ;
        sh:message "A source row must belong to exactly one view through isRowInView."@en
    ] ;
    rdfs:label "Row Location Shape"@en ;
    rdfs:comment "Requires each supplied source row to identify one resource view, including subclasses and untyped row-link endpoints. Coordinate bounds and view-to-source ownership are separate constraints."@en ;
    rdfs:isDefinedBy : .

:ColumnLocationShape a sh:NodeShape ;
    sh:targetClass :Column ;
    sh:targetObjectsOf :forColumn , :hasColumn ;
    sh:targetSubjectsOf :isColumnInView ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [
        sh:path [ sh:alternativePath ( :isColumnInView [ sh:inversePath :hasColumn ] ) ] ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ; sh:class :View ;
        sh:message "A physical source column must belong to exactly one view, counting isColumnInView and inverse hasColumn together."@en
    ] ;
    rdfs:label "Column Location Shape"@en ;
    rdfs:comment "Requires each physical source column to belong to one resource view. Counts both membership directions without requiring OWL inverse inference, and covers subclasses and untyped link endpoints."@en ;
    rdfs:isDefinedBy : .

