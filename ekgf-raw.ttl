:literalValue
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Value ;
    rdfs:range rdfs:Literal ;
    rdfs:label "Literal value"@en ;
    rdfs:comment "The source-supplied content of a captured value occurrence, represented as one RDF literal with its datatype or language retained. An empty string is content; a source null is represented by NullValue without this property."@en ;
    rdfs:isDefinedBy : .

:sourceText
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Value ;
    rdfs:range xsd:string ;
    rdfs:label "Source text"@en ;
    rdfs:comment "The original text of a captured value as exposed by the source reader before value normalization, when such text is available. This optional string preserves lexical details independently of literalValue and may record a source's explicit null marker."@en ;
    rdfs:isDefinedBy : .

