    rdfs:subClassOf :S3Entry ;
    rdfs:label "S3 user metadata entry"@en ;
    rdfs:comment "A user-defined metadata entry of an S3 object (an x-amz-meta- header), with the prefix removed from its key."@en ;
    rdfs:isDefinedBy : .

:s3Bucket
