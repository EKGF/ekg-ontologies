@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix api: <https://ekgf.org/ontology/api#> .
@prefix ux: <https://ekgf.org/ontology/user-experience#> .
@prefix lifecycle: <https://ekgf.org/ontology/lifecycle#> .
@base <https://ekgf.org/ontology/lifecycle#> .

<https://ekgf.org/ontology/lifecycle#>
    rdf:type owl:Ontology ;
    owl:imports api: ,
                ux: ;
    rdfs:label "EKGF Lifecycle Ontology"@en ;
    rdfs:comment """Everything has a lifecycle: use cases, stories, concepts, personas, outcomes, data products and datasets. This ontology says what a lifecycle is, which lifecycle a thing follows and which state the thing is in. It depends on none of the ontologies that describe those things.

A lifecycle is a named sequence of states, grouped into phases. There can be any number of lifecycles. This ontology ships one, the continuous improvement lifecycle; other ontologies and datasets define their own.

Which lifecycle a thing follows is decided in this order:

1. The lifecycle the thing names itself, with followsLifecycle.
2. The lifecycle that applies to a class of the thing, with appliesTo.

The state of a thing has to be a state of the lifecycle the thing follows."""@en .

#################################################################
#    Classes
#################################################################

lifecycle:Lifecycle rdf:type owl:Class ;
    rdfs:label "Lifecycle"@en ;
    rdfs:comment "A named sequence of states that a thing passes through, grouped into phases."@en .

lifecycle:Phase rdf:type owl:Class ;
    rdfs:label "Phase"@en ;
    rdfs:comment "A high-level part of a lifecycle that groups states."@en .

lifecycle:State rdf:type owl:Class ;
    rdfs:label "State"@en ;
    rdfs:comment "One state of a lifecycle."@en .

#################################################################
#    Object Properties
#################################################################

lifecycle:hasState rdf:type owl:ObjectProperty ,
                            owl:FunctionalProperty ;
    rdfs:range lifecycle:State ;
    rdfs:label "has state"@en ;
    rdfs:comment "The state a thing is in. It has no domain because anything can have a lifecycle."@en .

lifecycle:followsLifecycle rdf:type owl:ObjectProperty ,
                                    owl:FunctionalProperty ;
    rdfs:range lifecycle:Lifecycle ;
    rdfs:label "follows lifecycle"@en ;
    rdfs:comment "The lifecycle that this one thing follows. It takes precedence over the lifecycle that applies to the class of the thing. It has no domain because anything can have a lifecycle."@en .

lifecycle:appliesTo rdf:type owl:ObjectProperty ;
    rdfs:domain lifecycle:Lifecycle ;
    rdfs:range rdfs:Class ;
    rdfs:label "applies to"@en ;
    rdfs:comment "A class whose members follow this lifecycle unless they name another one. This is policy rather than vocabulary: an organization states it in its own data, and can state it differently."@en .

lifecycle:inLifecycle rdf:type owl:ObjectProperty ;
    rdfs:domain [ rdf:type owl:Class ;
                  owl:unionOf ( lifecycle:Phase
                                lifecycle:State
                              )
                ] ;
    rdfs:range lifecycle:Lifecycle ;
    rdfs:label "in lifecycle"@en ;
    rdfs:comment "The lifecycle that a phase or a state belongs to."@en .

lifecycle:phase rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
    rdfs:domain lifecycle:State ;
    rdfs:range lifecycle:Phase ;
    rdfs:label "phase"@en ;
    rdfs:comment "The phase that a state belongs to."@en .

#################################################################
#    Data Properties
#################################################################

lifecycle:order rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
    rdfs:domain lifecycle:State ;
    rdfs:range xsd:integer ;
    rdfs:label "order"@en ;
    rdfs:comment "Position of a state in the sequence of its lifecycle."@en .

#################################################################
#    The continuous improvement lifecycle
#################################################################

lifecycle:ContinuousImprovement rdf:type owl:NamedIndividual ,
        lifecycle:Lifecycle ;
    api:slug "continuous-improvement" ;
    rdfs:label "Continuous improvement"@en ;
    rdfs:comment "Plan, build, run and evolve, in nine states from identified to decommissioned."@en .

#    Phases

lifecycle:Plan rdf:type owl:NamedIndividual ,
        lifecycle:Phase ;
    api:slug "plan" ;
    rdfs:label "Plan"@en ;
    lifecycle:inLifecycle lifecycle:ContinuousImprovement ;
    ux:hexColor "#3b82f6" .

lifecycle:Build rdf:type owl:NamedIndividual ,
        lifecycle:Phase ;
    api:slug "build" ;
    rdfs:label "Build"@en ;
    lifecycle:inLifecycle lifecycle:ContinuousImprovement ;
    ux:hexColor "#d97706" .

lifecycle:Run rdf:type owl:NamedIndividual ,
        lifecycle:Phase ;
    api:slug "run" ;
    rdfs:label "Run"@en ;
    lifecycle:inLifecycle lifecycle:ContinuousImprovement ;
    ux:hexColor "#16a34a" .

lifecycle:Evolve rdf:type owl:NamedIndividual ,
        lifecycle:Phase ;
    api:slug "evolve" ;
    rdfs:label "Evolve"@en ;
    lifecycle:inLifecycle lifecycle:ContinuousImprovement ;
    ux:hexColor "#9333ea" .

#    States

lifecycle:Identified rdf:type owl:NamedIndividual ,
        lifecycle:State ;
    api:slug "identified" ;
    rdfs:label "Identified"@en ;
    lifecycle:inLifecycle lifecycle:ContinuousImprovement ;
    lifecycle:phase lifecycle:Plan ;
    lifecycle:order 1 .

lifecycle:Defined rdf:type owl:NamedIndividual ,
        lifecycle:State ;
    api:slug "defined" ;
    rdfs:label "Defined"@en ;
    lifecycle:inLifecycle lifecycle:ContinuousImprovement ;
    lifecycle:phase lifecycle:Plan ;
    lifecycle:order 2 .

lifecycle:Proposed rdf:type owl:NamedIndividual ,
        lifecycle:State ;
    api:slug "proposed" ;
    rdfs:label "Proposed"@en ;
    lifecycle:inLifecycle lifecycle:ContinuousImprovement ;
    lifecycle:phase lifecycle:Plan ;
    lifecycle:order 3 .

lifecycle:Planned rdf:type owl:NamedIndividual ,
        lifecycle:State ;
    api:slug "planned" ;
    rdfs:label "Planned"@en ;
    lifecycle:inLifecycle lifecycle:ContinuousImprovement ;
    lifecycle:phase lifecycle:Plan ;
    lifecycle:order 4 .

lifecycle:InProgress rdf:type owl:NamedIndividual ,
        lifecycle:State ;
    api:slug "in-progress" ;
    rdfs:label "In Progress"@en ;
    lifecycle:inLifecycle lifecycle:ContinuousImprovement ;
    lifecycle:phase lifecycle:Build ;
    lifecycle:order 5 .

lifecycle:Delivered rdf:type owl:NamedIndividual ,
        lifecycle:State ;
    api:slug "delivered" ;
    rdfs:label "Delivered"@en ;
    lifecycle:inLifecycle lifecycle:ContinuousImprovement ;
    lifecycle:phase lifecycle:Build ;
    lifecycle:order 6 .

lifecycle:Deployed rdf:type owl:NamedIndividual ,
        lifecycle:State ;
    api:slug "deployed" ;
    rdfs:label "Deployed"@en ;
    lifecycle:inLifecycle lifecycle:ContinuousImprovement ;
    lifecycle:phase lifecycle:Run ;
    lifecycle:order 7 .

lifecycle:Deprecated rdf:type owl:NamedIndividual ,
        lifecycle:State ;
    api:slug "deprecated" ;
    rdfs:label "Deprecated"@en ;
    lifecycle:inLifecycle lifecycle:ContinuousImprovement ;
    lifecycle:phase lifecycle:Evolve ;
    lifecycle:order 8 .

lifecycle:Decommissioned rdf:type owl:NamedIndividual ,
        lifecycle:State ;
    api:slug "decommissioned" ;
    rdfs:label "Decommissioned"@en ;
    lifecycle:inLifecycle lifecycle:ContinuousImprovement ;
    lifecycle:phase lifecycle:Evolve ;
    lifecycle:order 9 .
