@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sdlc: <https://ekgf.org/ontology/sdlc#> .
@base <https://ekgf.org/ontology/sdlc#> .

<https://ekgf.org/ontology/sdlc#>
    rdf:type owl:Ontology ;
    rdfs:label "Software Development Life Cycle (SDLC)"@en ;
    rdfs:comment "Simplistic ontology for the Software Development Life Cycle (SDLC). It records how far an artifact, such as a story, has come on its way to production. Formerly https://ekgf.org/ontology/software-development-life-cycle#."@en .

#################################################################
#    Classes
#################################################################

sdlc:Artifact rdf:type owl:Class ;
    rdfs:label "Artifact"@en ;
    rdfs:comment "Anything that is developed, tested and released."@en .

sdlc:LifeCycle rdf:type owl:Class ;
    rdfs:label "Life cycle"@en .

sdlc:Status rdf:type owl:Class ;
    rdfs:label "Status"@en ;
    rdfs:comment "A stage on the way to production."@en .

#################################################################
#    Object Properties
#################################################################

sdlc:status rdf:type owl:ObjectProperty ;
    rdfs:domain sdlc:Artifact ;
    rdfs:range sdlc:Status ;
    rdfs:label "status"@en ;
    rdfs:comment "The stage the artifact has reached."@en .

#################################################################
#    Individuals
#################################################################

sdlc:Development rdf:type owl:NamedIndividual ,
        sdlc:Status ;
    rdfs:label "Development"@en .

sdlc:Test rdf:type owl:NamedIndividual ,
        sdlc:Status ;
    rdfs:label "Test"@en .

sdlc:UAT rdf:type owl:NamedIndividual ,
        sdlc:Status ;
    rdfs:label "UAT"@en ;
    rdfs:comment "User Acceptance Test"@en .

sdlc:Production rdf:type owl:NamedIndividual ,
        sdlc:Status ;
    rdfs:label "Production"@en .

#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( sdlc:Development
                        sdlc:Test
                        sdlc:UAT
                        sdlc:Production
                      )
] .
